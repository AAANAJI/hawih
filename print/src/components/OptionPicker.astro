---
/**
 * OptionPicker — HelloPrint-style VISUAL configurator: every option value is
 * a card (auto-derived icon + label + optional sublabel + "+N ر.س" delta chip
 * + RECOMMENDED ribbon when flagged in the CRM print_options JSON). The
 * selected card gets the accent border; the group legend echoes the current
 * selection ("المقاس: 85×55" — kept live by the product-page script via
 * [data-opt-current] + input[data-text]).
 *
 * Conditional groups (see src/lib/options.ts): unchanged — a dependent group
 * carries data-cond-group / data-cond-value and starts hidden unless the
 * controller's default selects it. Only VISIBLE groups count toward price.
 *
 * Machine-readable contract (SAME as the select version, radios instead):
 * each group is [data-option-name][data-option-name-ar][data-option-type]
 * (+ cond attrs) and each input[type=radio] carries value=label_ar +
 * data-delta (+ data-text for the legend echo). Canonical Arabic → CRM.
 * NOTE: catalog-sync.ts renderOptions rebuilds this markup in JS — keep both
 * in lockstep (icons come from the SHARED @lib/option-visuals).
 *
 * Props:
 *   options: CatalogOption[]
 *   locale: 'ar' | 'en'
 *   name?: string   -> radio name prefix (default 'opt')
 */
import type { CatalogOption } from '@lib/catalog';
import type { Locale } from '@lib/format';
import { conditionalRefs, optionValueLabel, optionValueSub, optionGroupLabel } from '@lib/options';
import { optionIcon, formatDelta } from '@lib/option-visuals';
import { t } from '@lib/strings';

interface Props { options: CatalogOption[]; locale: Locale; name?: string }
const { options, locale, name = 'opt' } = Astro.props;

const refs = conditionalRefs(options);
// A conditional group starts visible only if its controller's FIRST value
// (the default selection) targets it.
function initiallyHidden(gi: number): boolean {
  const ref = refs[gi];
  if (!ref) return false;
  const controller = options.find((o) => o.name_ar === ref.group);
  return !controller || (controller.values[0]?.label_ar ?? '') !== ref.value;
}
---
<div class="pk-optpicker">
  {options.map((o, gi) => {
    const ref = refs[gi];
    return (
      <div
        class="pk-optgroup"
        data-option-name={o.name_ar}
        data-option-name-ar={o.name_ar}
        data-option-type={o.type}
        data-cond-group={ref ? ref.group : undefined}
        data-cond-value={ref ? ref.value : undefined}
        hidden={initiallyHidden(gi)}
      >
        <div class="pk-optgroup__legend">
          {optionGroupLabel(o, locale)}: <b data-opt-current>{optionValueLabel(o.values[0] ?? { label_ar: '', label_en: '', price_delta: 0 }, locale)}</b>
        </div>
        <div class="pk-optcards" role="radiogroup" aria-label={optionGroupLabel(o, locale)}>
          {o.values.map((v, vi) => {
            const label = optionValueLabel(v, locale);
            const sub = optionValueSub(v, locale);
            const delta = formatDelta(v.price_delta, locale);
            return (
              <label class="pk-optcard">
                <input
                  type="radio"
                  name={`${name}-${gi}`}
                  value={v.label_ar}
                  data-delta={v.price_delta}
                  data-text={label}
                  checked={vi === 0}
                />
                <span class="pk-optcard__icon" set:html={optionIcon(v.label_ar, v.label_en, v.icon ?? '')} />
                <span class="pk-optcard__label">{label}</span>
                {sub && <span class="pk-optcard__sub">{sub}</span>}
                {delta && <span class="pk-optcard__delta pk-price"><bdi>{delta}</bdi></span>}
                {v.recommended && <span class="pk-optcard__rec">{t('pdp.recommended', locale)}</span>}
              </label>
            );
          })}
        </div>
      </div>
    );
  })}
</div>
