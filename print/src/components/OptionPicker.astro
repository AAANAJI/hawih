---
/**
 * OptionPicker — renders every option group of a product from the unified
 * bilingual shape ({name_ar,name_en,type,values:[{label_ar,label_en,price_delta}]}).
 *   type 'select' -> segmented pill radios
 *   type 'tier'   -> quantity-tier pills
 * Any value may carry a price add-on (price_delta), shown as a "+N" chip.
 *
 * Each group is a fieldset the product script reads to compute price and build
 * the cart line. Canonical Arabic is used for the machine-readable name/value
 * (data-option-name = name_ar, radio value = label_ar) so orders in the CRM are
 * consistently Arabic; the visible text is localized.
 *   fieldset[data-option-name][data-option-name-ar][data-option-type]
 *   input[type=radio][data-delta]
 *
 * Props:
 *   options: CatalogOption[]
 *   locale: 'ar' | 'en'
 *   name?: string   -> radio group name prefix (default 'opt')
 */
import { optionName, valueLabel, type CatalogOption } from '@lib/catalog';
import type { Locale } from '@lib/format';
import { formatNumber } from '@lib/format';

interface Props { options: CatalogOption[]; locale: Locale; name?: string }
const { options, locale, name = 'opt' } = Astro.props;

const deltaLabel = (d: number) => (d === 0 ? '' : `+${formatNumber(d, locale)}`);
---
<div class="pk-optpicker">
  {options.map((o, gi) => {
    const label = optionName(o, locale);
    const groupName = `${name}-${gi}`;
    return (
      <fieldset
        class="pk-optgroup"
        role="radiogroup"
        aria-label={label}
        data-option-name={o.name_ar}
        data-option-name-ar={o.name_ar}
        data-option-type={o.type}
      >
        <legend class="pk-optgroup__label">{label}</legend>
        <div class="pk-optgroup__pills">
          {o.values.map((v, vi) => (
            <label class="pk-pill">
              <input
                type="radio"
                name={groupName}
                value={v.label_ar}
                data-delta={v.price_delta}
                checked={vi === 0}
              />
              <span>{valueLabel(v, locale)}</span>
              {v.price_delta > 0 && (
                <span class="pk-pill__delta">{deltaLabel(v.price_delta)}</span>
              )}
            </label>
          ))}
        </div>
      </fieldset>
    );
  })}
</div>
