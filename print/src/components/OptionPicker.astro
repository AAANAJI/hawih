---
/**
 * OptionPicker — renders every option group of a product as a labelled
 * <select> dropdown (the weej-style flow the owner asked for).
 *
 * Conditional groups (see src/lib/options.ts): a group whose name matches a
 * value of another group (e.g. quantity group "8" under selector value
 * "8 سم") carries data-cond-group / data-cond-value and starts hidden unless
 * the controller's default selects it. The product-page script toggles
 * visibility on change and only VISIBLE groups count toward the price and the
 * cart line.
 *
 * Machine-readable contract (kept from the pill version): each group is
 * [data-option-name][data-option-name-ar][data-option-type] and each <option>
 * carries value=label_ar + data-delta. Canonical Arabic goes to the CRM.
 * NOTE: catalog-sync.ts renderOptions rebuilds this markup in JS — keep both
 * in lockstep.
 *
 * Props:
 *   options: CatalogOption[]
 *   locale: 'ar' | 'en'
 *   name?: string   -> select id prefix (default 'opt')
 */
import type { CatalogOption } from '@lib/catalog';
import type { Locale } from '@lib/format';
import { conditionalRefs, optionValueText, optionGroupLabel } from '@lib/options';

interface Props { options: CatalogOption[]; locale: Locale; name?: string }
const { options, locale, name = 'opt' } = Astro.props;

const refs = conditionalRefs(options);
// A conditional group starts visible only if its controller's FIRST value
// (the default selection) targets it.
function initiallyHidden(gi: number): boolean {
  const ref = refs[gi];
  if (!ref) return false;
  const controller = options.find((o) => o.name_ar === ref.group);
  return !controller || (controller.values[0]?.label_ar ?? '') !== ref.value;
}
---
<div class="pk-optpicker">
  {options.map((o, gi) => {
    const ref = refs[gi];
    return (
      <div
        class="pk-optgroup"
        data-option-name={o.name_ar}
        data-option-name-ar={o.name_ar}
        data-option-type={o.type}
        data-cond-group={ref ? ref.group : undefined}
        data-cond-value={ref ? ref.value : undefined}
        hidden={initiallyHidden(gi)}
      >
        <label class="pk-optgroup__label" for={`${name}-${gi}`}>{optionGroupLabel(o, locale)}</label>
        <select class="pk-select" id={`${name}-${gi}`}>
          {o.values.map((v, vi) => (
            <option value={v.label_ar} data-delta={v.price_delta} selected={vi === 0}>
              {optionValueText(v, locale)}
            </option>
          ))}
        </select>
      </div>
    );
  })}
</div>
