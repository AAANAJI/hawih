---
/**
 * ProductCard — square image, tag, title, "starting from" price.
 * Whole card links to the product page. Price uses <bdi> LTR.
 * Props:
 *   href: string
 *   title: string
 *   image: string
 *   rate: number
 *   categoryLabel?: string
 *   locale: 'ar' | 'en'
 *   eager?: boolean
 *   itemMode?: string  -> the item's resolved price_mode ('' inherits global)
 */
import { formatCardPrice, itemPriceCfg } from '@lib/format';
import { storeConfig } from '@lib/catalog';
import { t } from '@lib/strings';
import type { Locale } from '@lib/format';

interface Props {
  href: string;
  title: string;
  image: string;
  rate: number;
  categoryLabel?: string;
  locale: Locale;
  eager?: boolean;
  itemMode?: string;
}
const { href, title, image, rate, categoryLabel, locale, eager = false, itemMode } = Astro.props;
// Range mode (per item, spec 013 R-9): "starting from" + the low bound
// (rule mirrored in live-sync).
const price = formatCardPrice(rate, itemPriceCfg(storeConfig, itemMode), locale);
---
<a class="pk-prodcard" href={href}>
  <div class="pk-prodcard__media">
    <img
      src={image}
      alt={title}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width="1200"
      height="1200"
      data-live-image
      onerror="this.style.visibility='hidden'"
    />
  </div>
  <div class="pk-prodcard__body">
    {categoryLabel && <span class="pk-prodcard__tag">{categoryLabel}</span>}
    <h3 class="pk-prodcard__title">{title}</h3>
    <div class="pk-prodcard__price pk-price">
      <span class="pk-from">{t('product.startingFrom', locale)}</span>
      <bdi data-live-price>{price}</bdi>
    </div>
  </div>
</a>
