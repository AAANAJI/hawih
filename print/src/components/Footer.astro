---
/**
 * Footer — multi-column: brand blurb + logo, categories, help/policies,
 * contact (phone LTR, WhatsApp, email), trust note, copyright, link back
 * to hawih.com.sa.
 * Props:
 *   locale: 'ar' | 'en'
 */
import { t } from '@lib/strings';
import { href } from '@lib/i18n';
import { categories, categoryTitle } from '@lib/catalog';
import { WHATSAPP, whatsappUrl, HAWIH_MAIN_URL } from '@lib/config';
import type { Locale } from '@lib/format';

interface Props { locale: Locale }
const { locale } = Astro.props;
const year = new Date().getFullYear();
const logo = '/img/logo/hawih-logo-white.png';
const phoneDisplay = '+966 50 218 5471';
const email = 'print@hawih.com.sa';
const cats = categories.slice(0, 6);
---
<footer class="pk-footer">
  <div class="pk-container">
    <div class="pk-footer__grid">
      <div>
        <div class="pk-footer__logo"><img src={logo} alt={t('brand.name', locale)} width="1080" height="390" /></div>
        <p class="pk-footer__brandtext">{t('footer.blurb', locale)}</p>
      </div>

      <div>
        <h4>{t('footer.categories', locale)}</h4>
        <ul>
          {cats.map((c) => (
            <li><a href={href(locale, `/category/${c.slug}`)}>{categoryTitle(c, locale)}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>{t('footer.help', locale)}</h4>
        <ul>
          <li><a href={href(locale, '/account')}>{t('footer.track', locale)}</a></li>
          <li><a href={href(locale, '/account')}>{t('footer.account', locale)}</a></li>
          <li><a href={href(locale, '/policies/shipping-returns')}>{t('footer.shipping', locale)}</a></li>
          <li><a href={href(locale, '/policies/privacy')}>{t('footer.privacy', locale)}</a></li>
          <li><a href={href(locale, '/policies/terms')}>{t('footer.terms', locale)}</a></li>
        </ul>
      </div>

      <div>
        <h4>{t('footer.contact', locale)}</h4>
        <ul class="pk-footer__contact">
          <li><span aria-hidden="true">📞</span> <a class="pk-footer__phone" href="tel:+966502185471" dir="ltr">{phoneDisplay}</a></li>
          <li><span aria-hidden="true">💬</span> <a href={whatsappUrl(locale === 'ar' ? undefined : 'Hello Hawih, I have an enquiry.')} target="_blank" rel="noopener">{t('footer.whatsapp', locale)}</a></li>
          <li><span aria-hidden="true">✉️</span> <a href={`mailto:${email}`} dir="ltr">{email}</a></li>
        </ul>
      </div>
    </div>

    <div class="pk-footer__trust">
      <span>© {year} {t('brand.name', locale)} — {t('footer.rights', locale)} · {t('footer.trustNote', locale)}</span>
      <a href={HAWIH_MAIN_URL} target="_blank" rel="noopener">{t('footer.mainSite', locale)} ↗</a>
    </div>
  </div>
</footer>
