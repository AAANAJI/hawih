---
/**
 * Header — sticky translucent header with logo, category dropdown, nav,
 * cart button (live badge), locale switch, and a mobile drawer.
 * Props:
 *   locale: 'ar' | 'en'
 * Reads the current path from Astro.url for the locale switch + aria-current.
 * Behaviour (scroll border, drawer open/close + focus trap, cart badge) is
 * wired by the inline script at the bottom.
 */
import Icon from '@components/Icon.astro';
import { t } from '@lib/strings';
import { href, switchLocalePath } from '@lib/i18n';
import { categories, categoryTitle } from '@lib/catalog';
import type { Locale } from '@lib/format';

interface Props { locale: Locale }
const { locale } = Astro.props;
const path = Astro.url.pathname;

const logo = '/img/logo/hawih-logo-dark.png';
const cats = categories.map((c) => ({
  title: categoryTitle(c, locale),
  href: href(locale, `/category/${c.slug}`),
}));

const nav = [
  { label: t('nav.allProducts', locale), href: href(locale, '/products') },
  { label: t('nav.about', locale), href: href(locale, '/about') },
  { label: t('nav.faq', locale), href: href(locale, '/faq') },
];
const otherLangHref = locale === 'ar' ? switchLocalePath(path, 'en') : switchLocalePath(path, 'ar');
const otherLangLabel = locale === 'ar' ? 'English' : 'العربية';
const otherLangCode = locale === 'ar' ? 'en' : 'ar';

const arHref = switchLocalePath(path, 'ar');
const enHref = switchLocalePath(path, 'en');
const homeHref = href(locale, '/');
const cartHref = href(locale, '/cart');
const productsHref = href(locale, '/products');
---
<header class="pk-header" data-header>
  <div class="pk-container pk-header__inner">
    <a class="pk-header__logo" href={homeHref} aria-label={t('brand.name', locale)}>
      <img src={logo} alt={t('brand.name', locale)} width="1080" height="390" />
    </a>

    <nav class="pk-header__nav" aria-label="primary">
      <div class="pk-dropdown">
        <button class="pk-navlink" aria-haspopup="true" aria-expanded="false" data-dropdown-btn>
          {t('nav.categories', locale)}
          <Icon name="chevron-down" size={14} />
        </button>
        <div class="pk-dropdown__menu" data-dropdown-menu>
          <a href={productsHref}>{t('nav.allProducts', locale)}</a>
          {cats.map((c) => <a href={c.href}>{c.title}</a>)}
        </div>
      </div>
      {nav.map((n) => (
        <a class="pk-navlink" href={n.href} aria-current={path === new URL(n.href, Astro.url).pathname ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="pk-header__spacer"></div>

    <div class="pk-header__actions">
      <a class="pk-btn pk-btn--sm pk-desktop-only" href={href(locale, '/contact')}>
        <Icon name="message-circle" size={15} />
        {t('nav.contact', locale)}
      </a>

      <a class="pk-langbtn pk-desktop-only" href={otherLangHref} lang={otherLangCode} title={otherLangLabel}>
        <Icon name="globe" size={16} />
        <span>{otherLangLabel}</span>
      </a>

      <a class="pk-navlink pk-iconbtn" href={href(locale, '/account')} aria-label={t('nav.account', locale)} title={t('nav.account', locale)}>
        <Icon name="user" size={20} />
      </a>

      <a class="pk-navlink pk-cartbtn" href={cartHref} aria-label={t('nav.cart', locale)} data-cart-open>
        <Icon name="cart" size={20} />
        <span class="pk-cartbtn__badge" data-cart-badge aria-hidden="true">0</span>
      </a>

      <button class="pk-hamburger" data-drawer-open aria-label={t('nav.menu', locale)} aria-expanded="false" aria-controls="pk-drawer">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mini-cart drawer (slides from the cart's side: left in RTL, right in LTR) -->
<div class="pk-drawer" id="pk-cartdrawer" data-cartdrawer>
  <div class="pk-drawer__scrim" data-cartdrawer-close></div>
  <div class="pk-minicart" role="dialog" aria-modal="true" aria-label={t('cart.title', locale)} data-locale={locale}>
    <div class="pk-minicart__head">
      <h2 class="pk-h3">{t('cart.title', locale)}</h2>
      <button type="button" class="pk-minicart__close" data-cartdrawer-close aria-label={t('nav.close', locale)}>
        <Icon name="x" size={18} />
      </button>
    </div>
    <div class="pk-minicart__lines" data-minicart-lines></div>
    <div class="pk-minicart__empty" data-minicart-empty hidden>
      <span class="pk-empty__icon" aria-hidden="true"><Icon name="cart" size={24} /></span>
      <p>{t('cart.empty.title', locale)}</p>
      <a class="pk-btn pk-btn--sm" href={href(locale, '/products')}>{t('cart.empty.cta', locale)}</a>
    </div>
    <div class="pk-minicart__foot" data-minicart-foot>
      <div class="pk-minicart__subtotal">
        <span>{t('cart.subtotal', locale)}</span>
        <bdi class="pk-price" data-minicart-total></bdi>
      </div>
      <a class="pk-btn pk-btn--block" href={href(locale, '/checkout')}>{t('cart.checkout', locale)}</a>
      <a class="pk-btn pk-btn--outline pk-btn--block" href={cartHref}>{t('minicart.viewCart', locale)}</a>
    </div>
  </div>
</div>

<!-- Mobile drawer -->
<div class="pk-drawer" id="pk-drawer" data-drawer>
  <div class="pk-drawer__scrim" data-drawer-close></div>
  <div class="pk-drawer__panel" role="dialog" aria-modal="true" aria-label={t('nav.menu', locale)}>
    <div class="pk-drawer__head">
      <img src={logo} alt={t('brand.name', locale)} width="1080" height="390" style="height:26px;width:auto" />
      <button class="pk-strip__close" data-drawer-close aria-label={t('nav.close', locale)} style="position:static;transform:none;color:var(--pk-ink)"><Icon name="x" size={18} /></button>
    </div>
    <a href={homeHref}>{t('nav.home', locale)}</a>
    <div class="pk-drawer__section">{t('nav.products', locale)}</div>
    <a href={productsHref}>{t('nav.allProducts', locale)}</a>
    {cats.map((c) => <a href={c.href}>{c.title}</a>)}
    <div class="pk-drawer__section">{t('brand.name', locale)}</div>
    <a href={href(locale, '/about')}>{t('nav.about', locale)}</a>
    <a href={href(locale, '/faq')}>{t('nav.faq', locale)}</a>
    <a href={href(locale, '/contact')}>{t('nav.contact', locale)}</a>
    <div class="pk-drawer__section">{t('nav.account', locale)}</div>
    <a href={href(locale, '/account')}>{t('nav.account', locale)}</a>
    <a href={cartHref}>{t('nav.cart', locale)}</a>
    <div class="pk-drawer__section">Language</div>
    <div class="pk-locale" style="align-self:flex-start;margin:8px 12px">
      <a href={arHref} aria-current={locale === 'ar' ? 'true' : undefined} lang="ar">العربية</a>
      <a href={enHref} aria-current={locale === 'en' ? 'true' : undefined} lang="en">EN</a>
    </div>
  </div>
</div>

<script>
  import { getCart, countItems, updateQty, removeLine, subtotal } from '@lib/cart';
  import { formatSAR } from '@lib/format';
  import { iconSvg } from '@lib/icons';
  import { t } from '@lib/strings';

  // Scroll border
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Cart badge
  const badge = document.querySelector<HTMLElement>('[data-cart-badge]');
  function renderBadge(count: number) {
    if (!badge) return;
    badge.textContent = String(count);
    badge.classList.toggle('is-active', count > 0);
  }
  renderBadge(countItems(getCart()));
  window.addEventListener('cart:change', (e) => {
    const detail = (e as CustomEvent).detail;
    renderBadge(detail?.count ?? countItems(getCart()));
  });
  window.addEventListener('storage', (e) => {
    if (e.key === 'hawih_print_cart') renderBadge(countItems(getCart()));
  });

  // Dropdown (click for touch/keyboard; hover handled by CSS)
  const ddBtn = document.querySelector<HTMLButtonElement>('[data-dropdown-btn]');
  const ddMenu = document.querySelector<HTMLElement>('[data-dropdown-menu]');
  ddBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const open = ddMenu?.classList.toggle('is-open');
    ddBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.addEventListener('click', (e) => {
    if (!ddBtn?.parentElement?.contains(e.target as Node)) {
      ddMenu?.classList.remove('is-open');
      ddBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Drawer with focus trap
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const openBtn = document.querySelector<HTMLElement>('[data-drawer-open]');
  const panel = drawer?.querySelector<HTMLElement>('.pk-drawer__panel');
  let lastFocused: HTMLElement | null = null;

  function focusables(): HTMLElement[] {
    if (!panel) return [];
    return Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
  }
  function openDrawer() {
    lastFocused = document.activeElement as HTMLElement;
    drawer?.classList.add('is-open');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    focusables()[0]?.focus();
  }
  function closeDrawer() {
    drawer?.classList.remove('is-open');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }
  openBtn?.addEventListener('click', openDrawer);
  drawer?.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (e) => {
    if (!drawer?.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeDrawer();
    if (e.key === 'Tab') {
      const f = focusables();
      if (f.length === 0) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // ---- Mini-cart drawer ----
  const cartDrawer = document.querySelector<HTMLElement>('[data-cartdrawer]');
  const cartOpenBtn = document.querySelector<HTMLElement>('[data-cart-open]');
  const mcLines = cartDrawer?.querySelector<HTMLElement>('[data-minicart-lines]');
  const mcEmpty = cartDrawer?.querySelector<HTMLElement>('[data-minicart-empty]');
  const mcFoot = cartDrawer?.querySelector<HTMLElement>('[data-minicart-foot]');
  const mcTotal = cartDrawer?.querySelector<HTMLElement>('[data-minicart-total]');
  const mcLocale = (cartDrawer?.querySelector<HTMLElement>('.pk-minicart')?.dataset.locale === 'en' ? 'en' : 'ar') as 'ar' | 'en';
  let cartLastFocused: HTMLElement | null = null;

  function renderMiniCart() {
    if (!mcLines || !mcEmpty || !mcFoot || !mcTotal) return;
    const lines = getCart();
    mcEmpty.hidden = lines.length > 0;
    mcFoot.hidden = lines.length === 0;
    mcLines.textContent = '';
    lines.forEach((line, i) => {
      const row = document.createElement('div');
      row.className = 'pk-mcline';

      const media = document.createElement('div');
      media.className = 'pk-mcline__img';
      if (line.image) {
        const img = document.createElement('img');
        img.src = line.image;
        img.alt = '';
        img.loading = 'lazy';
        img.addEventListener('error', () => { img.style.visibility = 'hidden'; });
        media.appendChild(img);
      }

      const mid = document.createElement('div');
      const title = document.createElement('div');
      title.className = 'pk-mcline__title';
      title.textContent = line.title;
      mid.appendChild(title);
      const optsText = Object.values(line.options || {}).join(' · ');
      if (optsText) {
        const opts = document.createElement('div');
        opts.className = 'pk-mcline__opts';
        opts.textContent = optsText;
        mid.appendChild(opts);
      }
      const qty = document.createElement('div');
      qty.className = 'pk-mcline__qty';
      const dec = document.createElement('button');
      dec.type = 'button';
      dec.innerHTML = iconSvg('minus');
      dec.setAttribute('aria-label', t('qty.decrease', mcLocale));
      dec.disabled = line.qty <= 1;
      dec.addEventListener('click', () => updateQty(i, line.qty - 1));
      const q = document.createElement('span');
      q.textContent = String(line.qty);
      const inc = document.createElement('button');
      inc.type = 'button';
      inc.innerHTML = iconSvg('plus');
      inc.setAttribute('aria-label', t('qty.increase', mcLocale));
      inc.addEventListener('click', () => updateQty(i, line.qty + 1));
      qty.append(dec, q, inc);
      mid.appendChild(qty);

      const side = document.createElement('div');
      side.className = 'pk-mcline__side';
      const price = document.createElement('bdi');
      price.className = 'pk-mcline__price pk-price';
      price.textContent = formatSAR(line.rate * line.qty, mcLocale);
      const rm = document.createElement('button');
      rm.type = 'button';
      rm.className = 'pk-mcline__rm';
      rm.innerHTML = iconSvg('trash');
      rm.setAttribute('aria-label', t('cart.remove', mcLocale));
      rm.addEventListener('click', () => removeLine(i));
      side.append(price, rm);

      row.append(media, mid, side);
      mcLines.appendChild(row);
    });
    mcTotal.textContent = formatSAR(subtotal(lines), mcLocale);
  }

  function openMiniCart() {
    if (!cartDrawer) return;
    cartLastFocused = document.activeElement as HTMLElement;
    renderMiniCart();
    cartDrawer.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    cartDrawer.querySelector<HTMLElement>('[data-cartdrawer-close]')?.focus();
  }
  function closeMiniCart() {
    cartDrawer?.classList.remove('is-open');
    document.body.style.overflow = '';
    cartLastFocused?.focus();
  }
  cartOpenBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    openMiniCart();
  });
  cartDrawer?.querySelectorAll('[data-cartdrawer-close]').forEach((el) => el.addEventListener('click', closeMiniCart));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && cartDrawer?.classList.contains('is-open')) closeMiniCart();
  });
  window.addEventListener('cart:change', () => {
    if (cartDrawer?.classList.contains('is-open')) renderMiniCart();
  });
</script>
