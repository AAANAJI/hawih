---
/**
 * Base.astro — the single page shell. Locale-aware <html>, Google Fonts,
 * GTM (head + noscript), favicon, SEOHead, HawihStrip + Header + Footer,
 * and a default slot for page content.
 *
 * USAGE (every page):
 *   <Base locale={locale} title="…" description="…" path="/canonical/path">
 *     …page content…
 *     <Fragment slot="head"> …extra head tags e.g. JsonLd… </Fragment>
 *   </Base>
 *
 * Props:
 *   locale: 'ar' | 'en'
 *   title: string
 *   description: string
 *   path: string            -> canonical root-relative path (Arabic form)
 *   image?: string          -> og image
 *   type?: string           -> og:type
 *   noindex?: boolean
 *   bodyClass?: string
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import SEOHead from '@components/SEOHead.astro';
import HawihStrip from '@components/HawihStrip.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { GTM_ID, MAINTENANCE, PREVIEW_KEY, whatsappUrl } from '@lib/config';
import { dirFor } from '@lib/i18n';
import type { Locale } from '@lib/format';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  bodyClass?: string;
}
const {
  locale,
  title,
  description,
  path,
  image,
  type,
  noindex,
  bodyClass = '',
} = Astro.props;
const dir = dirFor(locale);
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F1EB" />
    <!-- Mark JS available before first paint so reveal-on-scroll can hide
         elements only when JS is present to reveal them (no-JS = visible). -->
    <script is:inline>document.documentElement.classList.add('pk-js');</script>
    {MAINTENANCE && (
      <>
        <!-- Pre-launch gate: reveal the real site only when ?preview=<key> was used. -->
        <script define:vars={{ PREVIEW_KEY }}>
          (function () {
            try {
              var KEY = 'pk_preview';
              var p = new URLSearchParams(location.search).get('preview');
              if (p !== null) {
                if (p === PREVIEW_KEY) localStorage.setItem(KEY, '1');
                else if (p === 'off' || p === '0') localStorage.removeItem(KEY);
              }
              if (localStorage.getItem(KEY) === '1') document.documentElement.classList.add('pk-preview');
            } catch (e) {}
          })();
        </script>
        <style is:inline>
          #pk-maint{position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;background:#F4F1EB;color:#0B0B10;font-family:'IBM Plex Sans Arabic',system-ui,sans-serif;padding:24px;text-align:center}
          .pk-preview #pk-maint{display:none}
          #pk-maint .pk-maint__card{max-width:520px}
          #pk-maint img{height:46px;width:auto;margin-bottom:26px}
          #pk-maint h1{font-size:1.7rem;font-weight:700;margin:0 0 12px;color:#1F1FFE;line-height:1.4}
          #pk-maint p{font-size:1.05rem;line-height:1.75;margin:0 0 8px;color:#14141C}
          #pk-maint .pk-maint__en{font-family:Inter,system-ui,sans-serif;font-size:.92rem;color:#5b5b66;direction:ltr}
          #pk-maint a{display:inline-block;margin-top:22px;background:#1F1FFE;color:#fff;text-decoration:none;padding:12px 24px;border-radius:12px;font-weight:600}
          #pk-maint a:hover{background:#1414D6}
        </style>
      </>
    )}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap"
    />

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM_ID }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM_ID);
    </script>
    <!-- End Google Tag Manager -->

    <SEOHead
      title={title}
      description={description}
      locale={locale}
      path={path}
      image={image}
      type={type}
      noindex={noindex || MAINTENANCE}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {MAINTENANCE && (
      <div id="pk-maint" role="dialog" aria-label="قريباً">
        <div class="pk-maint__card">
          <img src="/img/logo/hawih-logo-dark.png" alt="Hawih" width="180" height="46" />
          <h1>متجر مطبعة هوية — قريباً</h1>
          <p>نضع اللمسات الأخيرة على متجرنا. عُد إلينا قريباً 🚀</p>
          <p class="pk-maint__en">Hawih Print — launching soon.</p>
          <a href={whatsappUrl()}>تواصل عبر واتساب</a>
        </div>
      </div>
    )}
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="gtm"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <HawihStrip locale={locale} />
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // Reveal-on-scroll for .pk-reveal (respects reduced motion via CSS).
      const els = document.querySelectorAll('.pk-reveal');
      if (els.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <script>
      // Live-render the catalog from the CRM on every visit: names, prices,
      // images, options, category membership and add/remove all reflect the
      // CRM instantly, falling back to the baked HTML if it is unreachable.
      import { catalogSync } from '@lib/catalog-sync';
      catalogSync();
    </script>
  </body>
</html>
