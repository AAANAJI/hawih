---
/**
 * Account — /account and /en/account.
 * Requires a token (redirects to login otherwise). Lists orders with status
 * chips + totals + a link to each order's detail. EmptyState when none.
 */
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import { localeStaticPaths, href } from '@lib/i18n';
import { t } from '@lib/strings';
import type { Locale } from '@lib/format';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const title = t('nav.account', locale);
const loginHref = href(locale, '/auth/login') + '?redirect=' + encodeURIComponent(href(locale, '/account'));
const shopHref = href(locale, '/');
const orderBase = href(locale, '/account/order');
---
<Base
  locale={locale}
  title={`${title} — ${t('brand.name', locale)}`}
  description={t('account.subtitle', locale)}
  path="/account"
  noindex={true}
>
  <div class="pk-container" style="min-height:56vh">
    <div class="pk-pagehead" style="display:flex;align-items:flex-end;justify-content:space-between;gap:var(--sp-4);flex-wrap:wrap">
      <div>
        <h1 class="pk-h1">{t('account.orders', locale)}</h1>
        <p>{t('account.subtitle', locale)}</p>
      </div>
      <button class="pk-btn pk-btn--ghost pk-btn--sm" data-logout>{t('auth.logout', locale)}</button>
    </div>

    <p class="pk-muted" data-orders-loading style="padding-block:var(--sp-6)">{t('account.loading', locale)}</p>

    <div class="pk-form-alert pk-form-alert--error" data-orders-error hidden style="margin-bottom:var(--sp-5)"></div>

    <div data-orders-empty hidden>
      <div class="pk-empty">
        <div class="pk-empty__icon" aria-hidden="true"><Icon name="package" size={26} /></div>
        <h2 class="pk-h2">{t('account.empty.title', locale)}</h2>
        <p>{t('account.empty.body', locale)}</p>
        <a class="pk-btn" href={shopHref}>{t('account.empty.cta', locale)}</a>
      </div>
    </div>

    <div class="pk-orderlist" data-orders-list hidden></div>
  </div>

  <script define:vars={{
    locale,
    loginHref,
    orderBase,
    labels: {
      orderNum: t('account.orderNum', locale),
      itemsCount: t('account.itemsCount', locale),
      view: t('account.view', locale),
      error: t('account.error', locale),
    },
  }}>
    window.__accountCfg = { locale, loginHref, orderBase, labels };
  </script>
  <script>
  import { iconSvg } from '@lib/icons';
    import { isAuthed, api, clearToken } from '@lib/api';
    import { formatSAR, arabicDate } from '@lib/format';
    import { href } from '@lib/i18n';

    const cfg = (window as any).__accountCfg;
    const L = cfg.labels;
    const locale = cfg.locale === 'en' ? 'en' : 'ar';

    const loadingEl = document.querySelector<HTMLElement>('[data-orders-loading]')!;
    const errorEl = document.querySelector<HTMLElement>('[data-orders-error]')!;
    const emptyEl = document.querySelector<HTMLElement>('[data-orders-empty]')!;
    const listEl = document.querySelector<HTMLElement>('[data-orders-list]')!;

    // Logout
    document.querySelector<HTMLButtonElement>('[data-logout]')?.addEventListener('click', async () => {
      try { await api.logout(); } catch { /* ignore */ }
      clearToken();
      location.href = href(locale, '/');
    });

    if (!isAuthed()) {
      location.replace(cfg.loginHref);
    } else {
      load();
    }

    function esc(s: string): string {
      return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    }

    async function load() {
      try {
        const res: any = await api.orders();
        loadingEl.hidden = true;
        if (!res || !res.success) { errorEl.textContent = L.error; errorEl.hidden = false; return; }
        const orders: any[] = res.orders || [];
        if (orders.length === 0) { emptyEl.hidden = false; return; }

        listEl.hidden = false;
        orders.forEach((o) => {
          const a = document.createElement('a');
          a.className = 'pk-card pk-ordercard';
          a.href = `${cfg.orderBase}?id=${encodeURIComponent(o.id)}`;
          const status = o.status || {};
          const color = status.color || '';
          const chip = color
            ? `<span class="pk-badge" style="background:${esc(color)}1f;color:${esc(color)}">${esc(status.title || '')}</span>`
            : `<span class="pk-badge pk-badge--muted">${esc(status.title || '')}</span>`;
          const dateStr = o.order_date ? arabicDate(o.order_date, locale) : '';
          const count = o.items_count != null ? `${o.items_count} ${L.itemsCount}` : '';
          a.innerHTML = `
            <div class="pk-ordercard__id">
              <span class="pk-ordercard__num">${esc(L.orderNum)} ${esc(String(o.id))}</span>
              <span class="pk-ordercard__meta">${esc(dateStr)}${count ? ' · ' + esc(count) : ''}</span>
            </div>
            <div class="pk-ordercard__status">${chip}</div>
            <div class="pk-ordercard__total pk-price"><bdi>${esc(formatSAR(Number(o.total || 0), locale))}</bdi></div>
            <div class="pk-ordercard__chev" aria-hidden="true">${iconSvg('chevron-start')}</div>`;
          listEl.appendChild(a);
        });
      } catch {
        loadingEl.hidden = true;
        errorEl.textContent = L.error;
        errorEl.hidden = false;
      }
    }
  </script>
</Base>
