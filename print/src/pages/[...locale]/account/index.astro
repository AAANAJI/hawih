---
/**
 * Account overview — /account and /en/account.
 * Stats (orders, open invoices, amount due) + recent orders + quick links.
 */
import AccountLayout from '@components/AccountLayout.astro';
import { localeStaticPaths, href } from '@lib/i18n';
import { t } from '@lib/strings';
import type { Locale } from '@lib/format';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const ordersHref = href(locale, '/account/orders');
const orderBase = href(locale, '/account/order');
const shopHref = href(locale, '/');
---
<AccountLayout locale={locale} active="overview" title={t('account.overview.title', locale)}>
  <div class="pk-acct__head">
    <h1 class="pk-h1">{t('account.overview.title', locale)}</h1>
    <p>{t('account.subtitle', locale)}</p>
  </div>

  <div class="pk-acct-stats">
    <div class="pk-acct-stat"><div class="pk-acct-stat__n" data-stat-orders>—</div><div class="pk-acct-stat__l">{t('account.overview.statOrders', locale)}</div></div>
    <div class="pk-acct-stat"><div class="pk-acct-stat__n" data-stat-open>—</div><div class="pk-acct-stat__l">{t('account.overview.statOpenInvoices', locale)}</div></div>
    <div class="pk-acct-stat"><div class="pk-acct-stat__n pk-price"><bdi data-stat-due>—</bdi></div><div class="pk-acct-stat__l">{t('account.overview.statDue', locale)}</div></div>
  </div>

  <div class="pk-acct-card">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);margin-bottom:var(--sp-3)">
      <h2 style="margin:0">{t('account.overview.recentOrders', locale)}</h2>
      <a class="pk-btn pk-btn--ghost pk-btn--sm" href={ordersHref}>{t('account.viewAll', locale)}</a>
    </div>
    <p class="pk-muted" data-recent-loading>{t('account.loadingGeneric', locale)}</p>
    <p class="pk-muted" data-recent-empty hidden>{t('account.overview.noRecent', locale)}</p>
    <div class="pk-acct-rows" data-recent hidden></div>
  </div>

  <script define:vars={{ orderBase, labels: {
    orderNum: t('account.orderNum', locale), items: t('account.itemsCount', locale),
  } }}>
    window.__ovCfg = { orderBase, labels };
  </script>
  <script>
    import { api } from '@lib/api';
    import { formatSAR, arabicDate } from '@lib/format';
    const cfg = (window as any).__ovCfg;
    const locale = location.pathname.startsWith('/en') ? 'en' : 'ar';
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    function fillStats(r: any) {
      const s = r.stats || {};
      const o = document.querySelector('[data-stat-orders]'); if (o) o.textContent = String(s.orders ?? 0);
      const op = document.querySelector('[data-stat-open]'); if (op) op.textContent = String(s.invoices_open ?? 0);
      const d = document.querySelector('[data-stat-due]'); if (d) d.textContent = formatSAR(Number(s.invoices_due || 0), locale);
    }
    // reuse identity fetch from the layout if it arrived
    if ((window as any).__acct) fillStats((window as any).__acct);
    else document.addEventListener('acct:ready', (e: any) => fillStats(e.detail));

    const loadEl = document.querySelector<HTMLElement>('[data-recent-loading]')!;
    const emptyEl = document.querySelector<HTMLElement>('[data-recent-empty]')!;
    const listEl = document.querySelector<HTMLElement>('[data-recent]')!;
    api.orders().then((res: any) => {
      loadEl.hidden = true;
      const orders: any[] = (res && res.orders) || [];
      if (!orders.length) { emptyEl.hidden = false; return; }
      listEl.hidden = false;
      orders.slice(0, 5).forEach((o) => {
        const a = document.createElement('a');
        a.className = 'pk-acct-row';
        a.href = `${cfg.orderBase}?id=${encodeURIComponent(o.id)}`;
        const st = o.status || {};
        const date = o.order_date ? arabicDate(o.order_date, locale) : '';
        a.innerHTML = `<span class="pk-acct-row__main">
            <span class="pk-acct-row__title">${esc(cfg.labels.orderNum)} ${esc(String(o.id))}</span>
            <span class="pk-acct-row__meta">${esc(date)} · ${esc(String(o.items_count || 0))} ${esc(cfg.labels.items)}</span>
          </span>
          <span class="pk-acct-row__end">
            <span class="pk-price"><bdi>${esc(formatSAR(Number(o.total || 0), locale))}</bdi></span>
            ${st.title ? `<span class="pk-badge pk-badge--muted">${esc(st.title)}</span>` : ''}
          </span>`;
        listEl.appendChild(a);
      });
    }).catch(() => { loadEl.hidden = true; emptyEl.hidden = false; });
  </script>
</AccountLayout>
