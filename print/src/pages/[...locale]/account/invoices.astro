---
/**
 * Invoices list — /account/invoices.
 */
import AccountLayout from '@components/AccountLayout.astro';
import { localeStaticPaths, href } from '@lib/i18n';
import { t } from '@lib/strings';
import type { Locale } from '@lib/format';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const invBase = href(locale, '/account/invoice');
---
<AccountLayout locale={locale} active="invoices" title={t('account.invoices.title', locale)}>
  <div class="pk-acct__head"><h1 class="pk-h1">{t('account.invoices.title', locale)}</h1></div>

  <p class="pk-muted" data-loading>{t('account.loadingGeneric', locale)}</p>
  <p class="pk-muted" data-empty hidden>{t('account.invoices.empty', locale)}</p>
  <div class="pk-acct-card" data-list hidden><div class="pk-acct-rows" data-rows></div></div>

  <script define:vars={{ invBase, statusLabels: {
    paid: t('account.invoices.status.paid', locale), not_paid: t('account.invoices.status.not_paid', locale),
    partially_paid: t('account.invoices.status.partially_paid', locale), draft: t('account.invoices.status.draft', locale),
  }, dueLabel: t('account.invoices.due', locale) }}>
    window.__invCfg = { invBase, statusLabels, dueLabel };
  </script>
  <script>
    import { api } from '@lib/api';
    import { formatSAR, arabicDate } from '@lib/format';
    const cfg = (window as any).__invCfg;
    const locale = location.pathname.startsWith('/en') ? 'en' : 'ar';
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const loadEl = document.querySelector<HTMLElement>('[data-loading]')!;
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
    const wrap = document.querySelector<HTMLElement>('[data-list]')!;
    const rows = document.querySelector<HTMLElement>('[data-rows]')!;
    api.invoices().then((res: any) => {
      loadEl.hidden = true;
      const items: any[] = (res && res.invoices) || [];
      if (!items.length) { emptyEl.hidden = false; return; }
      wrap.hidden = false;
      items.forEach((iv) => {
        const a = document.createElement('a');
        a.className = 'pk-acct-row';
        a.href = `${cfg.invBase}?id=${encodeURIComponent(iv.id)}`;
        const label = cfg.statusLabels[iv.status] || iv.status;
        const due = Number(iv.due || 0) > 0.001 ? `<span class="pk-acct-row__meta">${esc(cfg.dueLabel)}: <bdi>${esc(formatSAR(Number(iv.due), locale))}</bdi></span>` : '';
        a.innerHTML = `<span class="pk-acct-row__main">
            <span class="pk-acct-row__title">${esc(iv.display_id || ('#' + iv.id))}</span>
            <span class="pk-acct-row__meta">${esc(iv.invoice_date ? arabicDate(iv.invoice_date, locale) : '')}</span>
          </span>
          <span class="pk-acct-row__end">
            ${due}
            <span class="pk-price"><bdi>${esc(formatSAR(Number(iv.total || 0), locale))}</bdi></span>
            <span class="pk-stat-pill pk-stat-pill--${esc(iv.status)}">${esc(label)}</span>
          </span>`;
        rows.appendChild(a);
      });
    }).catch(() => { loadEl.hidden = true; emptyEl.hidden = false; });
  </script>
</AccountLayout>
