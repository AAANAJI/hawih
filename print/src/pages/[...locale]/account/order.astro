---
/**
 * Order detail — /account/order?id=N and /en/account/order?id=N.
 * Requires a token. Fetches the order + the full status set (for the
 * timeline), renders items table, uploaded files, and the invoice block
 * ("ادفع الآن" when a pay_url exists, otherwise bank transfer + WhatsApp).
 */
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import { localeStaticPaths, href } from '@lib/i18n';
import { t } from '@lib/strings';
import { BANK_TRANSFER, WHATSAPP } from '@lib/config';
import type { Locale } from '@lib/format';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const title = t('page.order', locale);
const loginHref = href(locale, '/auth/login') + '?redirect=' + encodeURIComponent(href(locale, '/account'));
const accountHref = href(locale, '/account/orders');
const bankName = locale === 'ar' ? BANK_TRANSFER.bank_name_ar : BANK_TRANSFER.bank_name_en;
---
<Base
  locale={locale}
  title={`${title} — ${t('brand.name', locale)}`}
  description={title}
  path="/account/order"
  noindex={true}
>
  <div class="pk-container" style="min-height:56vh">
    <a class="pk-btn pk-btn--ghost pk-btn--sm" href={accountHref} style="margin-top:var(--sp-6)">← {t('order.backToOrders', locale)}</a>

    <p class="pk-muted" data-order-loading style="padding-block:var(--sp-6)">{t('order.loading', locale)}</p>

    <div data-order-error hidden>
      <div class="pk-empty">
        <div class="pk-empty__icon" aria-hidden="true"><Icon name="search" size={26} /></div>
        <h2 class="pk-h2">{t('order.notFound', locale)}</h2>
        <a class="pk-btn" href={accountHref}>{t('order.backToOrders', locale)}</a>
      </div>
    </div>

    <div data-order-content hidden>
      <div class="pk-orderhead" style="margin-top:var(--sp-5)">
        <div>
          <h1 class="pk-h1" data-order-title></h1>
          <p class="pk-orderhead__meta" data-order-date></p>
        </div>
        <div data-order-statuschip></div>
      </div>

      <!-- Status timeline -->
      <section class="pk-card pk-block">
        <h2 class="pk-h3">{t('order.status', locale)}</h2>
        <p class="pk-order-exception" data-order-exception hidden></p>
        <ol class="pk-timeline" data-order-timeline aria-label={t('order.status', locale)}></ol>
      </section>

      <!-- Final-price approval (vendor-quote flow): shown only while the order
           is awaiting the client's approval of the reviewed final price. -->
      <section class="pk-card pk-block pk-approve" data-price-approval hidden>
        <h2 class="pk-h3" style="margin-bottom:var(--sp-2)"><Icon name="receipt" size={18} /> {t('order.priceApprovalTitle', locale)}</h2>
        <p class="pk-muted" style="margin-bottom:var(--sp-4)">{t('order.priceApprovalBody', locale)}</p>
        <div class="pk-approve__totals">
          <div class="pk-approve__row">
            <span class="pk-muted">{t('order.estimateWas', locale)}</span>
            <span class="pk-price" style="text-decoration:line-through;opacity:.6"><bdi data-approval-estimate>—</bdi></span>
          </div>
          <div class="pk-approve__row pk-approve__row--final">
            <span style="font-weight:700">{t('order.finalPrice', locale)}</span>
            <span class="pk-price" style="font-weight:800;font-size:1.25rem"><bdi data-approval-final>—</bdi></span>
          </div>
        </div>
        <p class="pk-small pk-muted" style="margin:var(--sp-2) 0 var(--sp-4)">{t('cart.taxNote', locale)}</p>
        <!-- Optional vendor pricing matrix — the client picks a supplier. -->
        <div class="pk-matrix-wrap" data-vendor-matrix hidden style="margin-bottom:var(--sp-4)"></div>
        <!-- Decline reason (revealed on first decline click). -->
        <div data-decline-reason-wrap hidden style="margin-bottom:var(--sp-4)">
          <label class="pk-small" style="font-weight:600;display:block;margin-bottom:var(--sp-2)">{t('order.declineReasonLabel', locale)}</label>
          <textarea class="pk-input" data-decline-reason rows="2" placeholder={t('order.declineReasonPlaceholder', locale)}></textarea>
        </div>
        <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap">
          <button type="button" class="pk-btn pk-btn--lg" data-approve-btn>{t('order.approve', locale)}</button>
          <button type="button" class="pk-btn pk-btn--outline pk-btn--lg" data-decline-btn>{t('order.decline', locale)}</button>
        </div>
        <p class="pk-form-alert pk-form-alert--error" data-approval-error hidden style="margin-top:var(--sp-3)"></p>
        <p class="pk-form-alert pk-form-alert--success" data-approval-done hidden style="margin-top:var(--sp-3)"></p>
      </section>

      <!-- Proof / sample approval (spec 013 R-2): rendered by mountProof()
           while a proof is pending; the approved proof is the binding
           quality reference. -->
      <section class="pk-card pk-block pk-approve" data-proof-approval hidden></section>

      <div class="pk-ordergrid">
        <div style="min-width:0">
          <!-- Items -->
          <section class="pk-card pk-block">
            <h2 class="pk-h3">{t('order.items', locale)}</h2>
            <div class="pk-otable__wrap">
              <table class="pk-otable">
                <thead>
                  <tr>
                    <th>{t('order.item', locale)}</th>
                    <th class="pk-num">{t('order.qty', locale)}</th>
                    <th class="pk-num">{t('order.rate', locale)}</th>
                    <th class="pk-num">{t('order.lineTotal', locale)}</th>
                  </tr>
                </thead>
                <tbody data-order-items></tbody>
                <tfoot>
                  <tr>
                    <td colspan="3">{t('order.subtotal', locale)}</td>
                    <td class="pk-num pk-price"><bdi data-order-subtotal>—</bdi></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </section>

          <!-- Note -->
          <section class="pk-card pk-block" data-order-note-wrap hidden>
            <h2 class="pk-h3">{t('order.note', locale)}</h2>
            <p class="pk-muted" data-order-note></p>
          </section>

          <!-- Design files — one uploader per order item -->
          <section class="pk-card pk-block" style="margin-bottom:0">
            <h2 class="pk-h3">{t('order.files', locale)}</h2>
            <p class="pk-small pk-muted" style="margin-top:calc(-1 * var(--sp-2))">{t('order.filesPerItemHint', locale)}</p>
            <div data-order-item-uploads></div>
            <!-- Legacy order-level files (older orders, not linked to a line) -->
            <div data-order-general hidden style="margin-top:var(--sp-5)">
              <h3 class="pk-h4" style="margin:0 0 var(--sp-2)">{t('order.generalFiles', locale)}</h3>
              <div class="pk-files" data-order-files></div>
            </div>
          </section>
        </div>

        <!-- Invoice -->
        <aside class="pk-card pk-summary">
          <h2 class="pk-h3">{t('order.invoice', locale)}</h2>
          <div class="pk-invoice" data-order-invoice>
            <div class="pk-invoice__row">
              <span class="pk-muted">{t('order.invoiceTotal', locale)}</span>
              <span class="pk-price" style="font-weight:700"><bdi data-invoice-total>—</bdi></span>
            </div>
            <div class="pk-invoice__row">
              <span class="pk-muted">{t('order.invoiceDue', locale)}</span>
              <span class="pk-invoice__due pk-price"><bdi data-invoice-due>—</bdi></span>
            </div>
            <div data-invoice-statuschip></div>
            <a class="pk-btn pk-btn--block" data-invoice-pay hidden target="_blank" rel="noopener">{t('order.pay', locale)}</a>
          </div>

          <!-- Bank transfer fallback -->
          <div class="pk-bank" data-bank-block>
            <h3>{t('bank.title', locale)}</h3>
            <dl class="pk-bank__rows">
              <div class="pk-bank__row"><dt>{t('bank.bank', locale)}</dt><dd>{bankName}</dd></div>
              <div class="pk-bank__row"><dt>{t('bank.accountName', locale)}</dt><dd>{BANK_TRANSFER.account_name}</dd></div>
              <div class="pk-bank__row"><dt>{t('bank.iban', locale)}</dt><dd>{BANK_TRANSFER.iban}</dd></div>
            </dl>
            <p class="pk-bank__note">{t('bank.note', locale)}</p>
          </div>
          <a class="pk-btn pk-btn--outline pk-btn--block" data-whatsapp target="_blank" rel="noopener">
            <Icon name="message-circle" size={16} /> {t('whatsapp.cta', locale)}
          </a>
        </aside>
      </div>
    </div>
  </div>

  <script define:vars={{
    locale,
    loginHref,
    whatsapp: WHATSAPP,
    waPrefix: locale === 'ar' ? 'مرحباً هوية، بخصوص طلبي رقم ' : 'Hello Hawih, regarding my order ',
    labels: {
      orderTitle: t('account.orderNum', locale),
      placedOn: t('order.placedOn', locale),
      uploadBtn: t('order.uploadBtn', locale),
      itemHint: t('order.uploadItemHint', locale),
      uploading: t('order.uploading', locale),
      uploadError: t('order.uploadError', locale),
      approvedMsg: t('order.approvedMsg', locale),
      declinedMsg: t('order.declinedMsg', locale),
      respondError: t('order.respondError', locale),
      pricePendingNote: t('order.pricePendingNote', locale),
      matrixTitle: t('order.matrixTitle', locale),
      matrixHint: t('order.matrixHint', locale),
      vendor: t('order.vendor', locale),
      recommended: t('order.recommended', locale),
      leadTime: t('order.leadTime', locale),
      days: t('order.days', locale),
      deliversOffice: t('order.deliversOffice', locale),
      declineConfirm: t('order.declineConfirm', locale),
      declineReasonLabel: t('order.declineReasonLabel', locale),
    },
  }}>
    window.__orderCfg = { locale, loginHref, whatsapp, waPrefix, labels };
  </script>
  <script>
  import { iconSvg } from '@lib/icons';
    import { isAuthed, api } from '@lib/api';
    import { formatSAR, arabicDate, formatFileSize } from '@lib/format';
    import { buildItemUploader } from '@lib/itemUpload';

    const cfg = (window as any).__orderCfg;
    const L = cfg.labels;
    const locale = cfg.locale === 'en' ? 'en' : 'ar';

    const params = new URLSearchParams(location.search);
    const id = params.get('id');

    const loadingEl = document.querySelector<HTMLElement>('[data-order-loading]')!;
    const errorEl = document.querySelector<HTMLElement>('[data-order-error]')!;
    const contentEl = document.querySelector<HTMLElement>('[data-order-content]')!;

    function esc(s: any): string {
      return String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    }
    function showError() { loadingEl.hidden = true; errorEl.hidden = false; }

    if (!isAuthed()) {
      location.replace(cfg.loginHref);
    } else if (!id) {
      showError();
    } else {
      load(id);
    }

    async function load(orderId: string) {
      try {
        const [orderRes, statusesRes] = await Promise.all([api.order(orderId), api.orderStatuses()]);
        if (!orderRes || !orderRes.success || !(orderRes as any).order) { showError(); return; }
        render((orderRes as any).order, ((statusesRes as any)?.statuses) || []);
      } catch {
        showError();
      }
    }

    function render(order: any, statuses: any[]) {
      loadingEl.hidden = true;
      contentEl.hidden = false;

      // Header
      (document.querySelector('[data-order-title]') as HTMLElement).textContent = `${L.orderTitle} ${order.id}`;
      const dateEl = document.querySelector('[data-order-date]') as HTMLElement;
      dateEl.textContent = order.order_date ? `${L.placedOn}: ${arabicDate(order.order_date, locale)}` : '';

      const status = order.status || {};
      const chip = document.querySelector('[data-order-statuschip]') as HTMLElement;
      if (status.title) {
        chip.innerHTML = status.color
          ? `<span class="pk-badge" style="background:${esc(status.color)}1f;color:${esc(status.color)}">${esc(status.title)}</span>`
          : `<span class="pk-badge pk-badge--muted">${esc(status.title)}</span>`;
      }

      // Clean linear print pipeline (curated) — not the raw 11-status list.
      // Display labels are decoupled from CRM titles; the current status is
      // matched by title. Exception states (on-hold / rejected) show as a
      // banner instead of a timeline step. `statuses` is unused now on purpose.
      void statuses;
      const PIPELINE = [
        { keys: ['new', 'جديد', 'processing', 'confirmed', 'تم استلام الطلب'], ar: 'تم استلام الطلب', en: 'Order received' },
        // Vendor-quote flow: pricing → the client approves the final price.
        { keys: ['بانتظار التسعير'], ar: 'تسعير الطلب', en: 'Pricing' },
        { keys: ['بانتظار اعتماد السعر'], ar: 'اعتماد السعر', en: 'Price approval' },
        // Funds-first spine (spec 013 phase 2): pay → proof → production.
        { keys: ['بانتظار الدفع'], ar: 'الدفع', en: 'Payment' },
        { keys: ['بانتظار اعتماد البروفة'], ar: 'اعتماد البروفة', en: 'Proof approval' },
        { keys: ['مراجعة التصميم'], ar: 'مراجعة التصميم', en: 'Design review' },
        { keys: ['معتمد'], ar: 'معتمد', en: 'Approved' },
        { keys: ['قيد الطباعة'], ar: 'قيد الطباعة', en: 'In production' },
        { keys: ['جاهز للاستلام'], ar: 'جاهز للاستلام', en: 'Ready for pickup' },
        { keys: ['تم الشحن', 'بانتظار توقيع الاستلام'], ar: 'التسليم والتوقيع', en: 'Delivery & sign-off' },
        { keys: ['تم التسليم'], ar: 'تم التسليم', en: 'Delivered' },
      ];
      const EXCEPTIONS: Record<string, { ar: string; en: string }> = {
        'معلق': { ar: 'طلبك معلّق مؤقتاً — سنتواصل معك قريباً.', en: 'Your order is on hold — we will contact you shortly.' },
        'مرفوض': { ar: 'عذراً، تم رفض هذا الطلب. يرجى التواصل معنا.', en: 'This order was rejected. Please contact us.' },
      };

      const timeline = document.querySelector('[data-order-timeline]') as HTMLElement;
      const exEl = document.querySelector('[data-order-exception]') as HTMLElement;
      const curTitle = String(status.title || '').trim();
      const curKey = curTitle.toLowerCase();

      if (EXCEPTIONS[curTitle]) {
        // Interrupted flow — show a banner, hide the step list.
        exEl.textContent = EXCEPTIONS[curTitle][locale];
        exEl.hidden = false;
        timeline.hidden = true;
      } else {
        let currentIdx = PIPELINE.findIndex((step) => step.keys.some((k) => k.toLowerCase() === curKey));
        if (currentIdx < 0) currentIdx = 0; // unknown/stock → treat as "received"
        PIPELINE.forEach((step, i) => {
          const state = i < currentIdx ? 'is-done' : i === currentIdx ? 'is-current' : 'is-future';
          const li = document.createElement('li');
          li.className = `pk-timeline__step ${state}`;
          if (i === currentIdx) li.setAttribute('aria-current', 'step');
          li.innerHTML = `<span class="pk-timeline__dot" aria-hidden="true">${i < currentIdx ? iconSvg('check') : i + 1}</span><span class="pk-timeline__label">${esc(step[locale])}</span>`;
          timeline.appendChild(li);
        });
      }

      // Items
      const tbody = document.querySelector('[data-order-items]') as HTMLElement;
      const items: any[] = order.items || [];
      items.forEach((it) => {
        const unit = it.unit_type ? ` <span style="color:var(--pk-ink-muted)">/ ${esc(it.unit_type)}</span>` : '';
        // Post-award: show the original estimate struck through next to the
        // final rate, so the client sees exactly what changed.
        const hasEst = it.estimate_rate != null && Number(it.estimate_rate) !== Number(it.rate || 0);
        const estHtml = hasEst
          ? `<div class="pk-small" style="text-decoration:line-through;opacity:.55"><bdi>${esc(formatSAR(Number(it.estimate_rate), locale))}</bdi></div>`
          : '';
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><div style="font-weight:600">${esc(it.title)}</div>${it.description ? `<div class="pk-otable__desc">${esc(it.description)}</div>` : ''}</td>
          <td class="pk-num">${esc(it.quantity)}${unit}</td>
          <td class="pk-num pk-price">${estHtml}<bdi>${esc(formatSAR(Number(it.rate || 0), locale))}</bdi></td>
          <td class="pk-num pk-price"><bdi>${esc(formatSAR(Number(it.total || 0), locale))}</bdi></td>`;
        tbody.appendChild(tr);
      });
      const subEl = document.querySelector('[data-order-subtotal]') as HTMLElement;
      const sub = order.total_summary != null ? Number(order.total_summary) : items.reduce((s, it) => s + Number(it.total || 0), 0);
      subEl.textContent = formatSAR(sub, locale);

      // Note
      if (order.note) {
        (document.querySelector('[data-order-note-wrap]') as HTMLElement).hidden = false;
        (document.querySelector('[data-order-note]') as HTMLElement).textContent = order.note;
      }

      // Design files — one uploader per order item (links each file to its line).
      const itemUploadsEl = document.querySelector('[data-order-item-uploads]') as HTMLElement;
      const itemLabels = { uploadBtn: L.uploadBtn, uploading: L.uploading, uploadError: L.uploadError, hint: L.itemHint };
      items.forEach((it) => {
        const block = document.createElement('div');
        block.className = 'pk-itemup-block';
        const title = document.createElement('div');
        title.className = 'pk-itemup-block__title';
        title.textContent = it.title;
        block.appendChild(title);
        block.appendChild(buildItemUploader({ orderId: order.id, itemId: it.item_id, files: it.files || [], labels: itemLabels }));
        itemUploadsEl.appendChild(block);
      });

      // Legacy order-level files (older orders uploaded before per-item linking).
      const general: any[] = order.files || [];
      if (general.length) {
        (document.querySelector('[data-order-general]') as HTMLElement).hidden = false;
        renderLegacyFiles(general);
      }

      // Invoice
      const inv = order.invoice;
      const totalEl = document.querySelector('[data-invoice-total]') as HTMLElement;
      const dueEl = document.querySelector('[data-invoice-due]') as HTMLElement;
      const invChip = document.querySelector('[data-invoice-statuschip]') as HTMLElement;
      const payBtn = document.querySelector('[data-invoice-pay]') as HTMLAnchorElement;
      if (inv) {
        totalEl.textContent = formatSAR(Number(inv.total ?? sub), locale);
        dueEl.textContent = formatSAR(Number(inv.due ?? inv.total ?? sub), locale);
        if (inv.status) invChip.innerHTML = `<span class="pk-badge pk-badge--muted">${esc(inv.status)}</span>`;
        if (inv.pay_url) { payBtn.hidden = false; payBtn.href = inv.pay_url; }
      } else {
        totalEl.textContent = formatSAR(sub, locale);
        dueEl.textContent = formatSAR(sub, locale);
      }

      // WhatsApp CTA
      const wa = document.querySelector('[data-whatsapp]') as HTMLAnchorElement;
      wa.href = `https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(cfg.waPrefix + order.id)}`;

      // ---- Proof / sample approval (spec 013 R-2) ----
      mountProof(order);

      // ---- Vendor-quote price states ----
      if (order.price_state === 'awaiting_approval') {
        mountApproval(order);
      } else if (order.price_state === 'estimate') {
        // Order is still being priced — set expectations under the timeline.
        const note = document.createElement('p');
        note.className = 'pk-small pk-muted';
        note.style.marginTop = 'var(--sp-3)';
        note.textContent = L.pricePendingNote;
        (document.querySelector('[data-order-timeline]') as HTMLElement).insertAdjacentElement('afterend', note);
      }
    }

    /**
     * Proof / sample approval (spec 013 R-2). Shows while the latest proof is
     * pending: file links, approve (binding reference) or reject with a
     * reason (staff send a new version — no dead-end). Fully JS-rendered.
     */
    function mountProof(order: any) {
      const block = document.querySelector('[data-proof-approval]') as HTMLElement;
      const proofs: any[] = Array.isArray(order.proofs) ? order.proofs : [];
      const latest = proofs[0];
      if (!block || !latest || latest.status !== 'pending') return;

      const P = {
        ar: {
          title: latest.type === 'sample' ? 'اعتماد العينة' : 'اعتماد البروفة',
          body: 'راجع الملفات بعناية — اعتمادك يصبح المرجع الملزم للجودة عند التسليم.',
          version: 'النسخة', approve: 'اعتماد', reject: 'طلب تعديل',
          reasonLabel: 'ما الذي تريد تعديله؟', reasonPh: 'اكتب ملاحظاتك…',
          approvedMsg: 'تم الاعتماد — سنبدأ التنفيذ.', rejectedMsg: 'أُرسلت ملاحظاتك — سنوافيك بنسخة معدّلة.',
          err: 'تعذّر الإرسال. حاول مرة أخرى.',
        },
        en: {
          title: latest.type === 'sample' ? 'Sample approval' : 'Proof approval',
          body: 'Review the files carefully — your approval becomes the binding quality reference at delivery.',
          version: 'Version', approve: 'Approve', reject: 'Request changes',
          reasonLabel: 'What should we change?', reasonPh: 'Write your notes…',
          approvedMsg: 'Approved — production starts.', rejectedMsg: 'Your notes were sent — a revised version will follow.',
          err: 'Could not send. Please try again.',
        },
      }[locale];

      const filesHtml = (latest.files || [])
        .map((f: any) => `<a class="pk-btn pk-btn--outline" href="${esc(String(f.url || ''))}" target="_blank" rel="noopener">📄 ${esc(String(f.name || 'proof'))}</a>`)
        .join(' ');
      block.innerHTML = `
        <h2 class="pk-h3" style="margin-bottom:var(--sp-2)">🖼 ${esc(P.title)} <span class="pk-muted pk-small">(${esc(P.version)} ${Number(latest.version) || 1})</span></h2>
        <p class="pk-muted" style="margin-bottom:var(--sp-4)">${esc(P.body)}</p>
        ${latest.note ? `<p class="pk-small" style="margin-bottom:var(--sp-3)">${esc(String(latest.note))}</p>` : ''}
        <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-bottom:var(--sp-4)">${filesHtml}</div>
        <div data-proof-reason-wrap hidden style="margin-bottom:var(--sp-4)">
          <label class="pk-small" style="font-weight:600;display:block;margin-bottom:var(--sp-2)">${esc(P.reasonLabel)}</label>
          <textarea class="pk-input" data-proof-reason rows="2" placeholder="${esc(P.reasonPh)}"></textarea>
        </div>
        <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap">
          <button type="button" class="pk-btn pk-btn--lg" data-proof-approve>${esc(P.approve)}</button>
          <button type="button" class="pk-btn pk-btn--outline pk-btn--lg" data-proof-reject>${esc(P.reject)}</button>
        </div>
        <p class="pk-form-alert pk-form-alert--error" data-proof-error hidden style="margin-top:var(--sp-3)"></p>
        <p class="pk-form-alert pk-form-alert--success" data-proof-done hidden style="margin-top:var(--sp-3)"></p>`;
      block.hidden = false;

      const okBtn = block.querySelector('[data-proof-approve]') as HTMLButtonElement;
      const noBtn = block.querySelector('[data-proof-reject]') as HTMLButtonElement;
      const errEl = block.querySelector('[data-proof-error]') as HTMLElement;
      const doneEl = block.querySelector('[data-proof-done]') as HTMLElement;
      const reasonWrap = block.querySelector('[data-proof-reason-wrap]') as HTMLElement;
      const reasonEl = block.querySelector('[data-proof-reason]') as HTMLTextAreaElement;
      let rejectArmed = false;

      async function respond(action: 'approve' | 'reject', reason = '') {
        errEl.hidden = true;
        okBtn.disabled = true;
        noBtn.disabled = true;
        try {
          const res: any = await api.orderProofRespond(order.id, action, reason);
          if (res && res.success) {
            doneEl.textContent = action === 'approve' ? P.approvedMsg : P.rejectedMsg;
            doneEl.hidden = false;
            okBtn.hidden = true;
            noBtn.hidden = true;
            setTimeout(() => location.reload(), 1800);
            return;
          }
          errEl.textContent = (res && res.message) || P.err;
          errEl.hidden = false;
        } catch {
          errEl.textContent = P.err;
          errEl.hidden = false;
        }
        okBtn.disabled = false;
        noBtn.disabled = false;
      }

      okBtn.addEventListener('click', () => respond('approve'));
      noBtn.addEventListener('click', () => {
        // Two-step: first click reveals the reason box, second submits.
        if (!rejectArmed) { rejectArmed = true; reasonWrap.hidden = false; reasonEl.focus(); return; }
        respond('reject', reasonEl.value.trim());
      });
    }

    /** Final-price approval block: old→new totals + approve/decline. */
    function mountApproval(order: any) {
      const block = document.querySelector('[data-price-approval]') as HTMLElement;
      if (!block) return;
      const approval = order.approval || {};
      const estEl = block.querySelector('[data-approval-estimate]') as HTMLElement;
      const finEl = block.querySelector('[data-approval-final]') as HTMLElement;
      const est = Number(approval.estimate_total);
      const fin = Number(approval.final_total ?? order.total_summary ?? 0);
      // Hide the strikethrough row when there's nothing meaningful to compare.
      if (Number.isFinite(est) && est > 0 && est !== fin) {
        estEl.textContent = formatSAR(est, locale);
      } else {
        (estEl.closest('.pk-approve__row') as HTMLElement).hidden = true;
      }
      finEl.textContent = formatSAR(fin, locale);

      const approveBtn = block.querySelector('[data-approve-btn]') as HTMLButtonElement;
      const declineBtn = block.querySelector('[data-decline-btn]') as HTMLButtonElement;
      const errEl = block.querySelector('[data-approval-error]') as HTMLElement;
      const doneEl = block.querySelector('[data-approval-done]') as HTMLElement;
      const reasonWrap = block.querySelector('[data-decline-reason-wrap]') as HTMLElement;
      const reasonEl = block.querySelector('[data-decline-reason]') as HTMLTextAreaElement;

      // Optional vendor matrix — the client picks a supplier (their choice re-awards).
      renderMatrix(approval.matrix, block, finEl);

      let declineArmed = false;

      async function respond(action: 'approve' | 'decline', extra: { choice?: number; reason?: string } = {}) {
        errEl.hidden = true;
        approveBtn.disabled = true;
        declineBtn.disabled = true;
        try {
          const res: any = await api.orderPriceRespond(order.id, action, extra);
          if (res && res.success) {
            doneEl.textContent = action === 'approve' ? L.approvedMsg : L.declinedMsg;
            doneEl.hidden = false;
            approveBtn.hidden = true;
            declineBtn.hidden = true;
            setTimeout(() => location.reload(), 1800);
            return;
          }
          errEl.textContent = (res && res.message) ? res.message : L.respondError;
          errEl.hidden = false;
        } catch {
          errEl.textContent = L.respondError;
          errEl.hidden = false;
        }
        approveBtn.disabled = false;
        declineBtn.disabled = false;
      }

      approveBtn.addEventListener('click', () => {
        const picked = block.querySelector('input[name="pk-vendor-choice"]:checked') as HTMLInputElement | null;
        respond('approve', picked ? { choice: Number(picked.value) } : {});
      });
      declineBtn.addEventListener('click', () => {
        // Two-step: first click reveals the reason field, second submits it.
        if (!declineArmed) {
          declineArmed = true;
          reasonWrap.hidden = false;
          reasonEl.focus();
          declineBtn.textContent = L.declineConfirm;
          return;
        }
        respond('decline', { reason: reasonEl.value.trim() });
      });
      block.hidden = false;
    }

    /** Render the (optional) anonymized vendor pricing matrix; client picks one. */
    function renderMatrix(matrix: any, block: HTMLElement, finEl: HTMLElement) {
      const wrap = block.querySelector('[data-vendor-matrix]') as HTMLElement;
      if (!wrap || !matrix || !Array.isArray(matrix.vendors) || matrix.vendors.length === 0) return;
      const items: any[] = matrix.items || [];
      const letter = (i: number) => String.fromCharCode(65 + (i % 26));

      wrap.innerHTML = `<div class="pk-matrix__title">${esc(L.matrixTitle)}</div><p class="pk-matrix__hint">${esc(L.matrixHint)}</p>`;
      matrix.vendors.forEach((v: any) => {
        const name = v.label || `${L.vendor} ${letter(Number(v.choice))}`;
        const lines = items.map((it) => {
          const p = it.prices ? it.prices[String(v.choice)] : null;
          const low = it.lowest_choice === v.choice;
          return `<div class="pk-matrix__line"><span>${esc(it.title)}</span><span class="pk-price${low ? ' pk-matrix__low' : ''}">${p != null ? esc(formatSAR(Number(p), locale)) : '—'}</span></div>`;
        }).join('');
        const meta = [`${esc(L.leadTime)}: ${esc(v.lead_time_days)} ${esc(L.days)}`, v.delivers_to_office ? esc(L.deliversOffice) : '']
          .filter(Boolean).join(' · ');
        const card = document.createElement('label');
        card.className = 'pk-matrix__card';
        card.innerHTML =
          `<div class="pk-matrix__head">` +
            `<input type="radio" name="pk-vendor-choice" value="${v.choice}"${v.recommended ? ' checked' : ''}>` +
            `<span class="pk-matrix__name">${esc(name)}</span>` +
            (v.recommended ? `<span class="pk-matrix__rec">${esc(L.recommended)}</span>` : '') +
            `<span class="pk-matrix__total pk-price">${esc(formatSAR(Number(v.total), locale))}</span>` +
          `</div>` +
          `<div class="pk-matrix__meta">${meta}</div>` +
          `<div class="pk-matrix__lines">${lines}</div>`;
        wrap.appendChild(card);
      });
      // Keep the headline "final price" in sync with the picked vendor's total.
      wrap.addEventListener('change', (e) => {
        const r = e.target as HTMLInputElement;
        if (r && r.name === 'pk-vendor-choice') {
          const v = matrix.vendors.find((x: any) => String(x.choice) === r.value);
          if (v) finEl.textContent = formatSAR(Number(v.total), locale);
        }
      });
      wrap.hidden = false;
    }

    /** Render legacy order-level files (read-only — new uploads go per item). */
    function renderLegacyFiles(files: any[]) {
      const filesEl = document.querySelector('[data-order-files]') as HTMLElement;
      filesEl.innerHTML = '';
      files.forEach((f) => {
        const div = document.createElement('div');
        div.className = 'pk-fileline';
        const size = f.file_size != null ? formatFileSize(Number(f.file_size)) : '';
        div.innerHTML = `<div class="pk-fileline__name">${iconSvg('paperclip')}<span>${esc(f.file_name)}</span></div>${size ? `<span class="pk-fileline__size">${esc(size)}</span>` : ''}`;
        filesEl.appendChild(div);
      });
    }
  </script>
</Base>
