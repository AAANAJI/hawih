---
/**
 * Support tickets — /account/tickets. List + open a new ticket.
 */
import AccountLayout from '@components/AccountLayout.astro';
import Icon from '@components/Icon.astro';
import { localeStaticPaths, href } from '@lib/i18n';
import { t } from '@lib/strings';
import type { Locale } from '@lib/format';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const ticketBase = href(locale, '/account/ticket');
---
<AccountLayout locale={locale} active="tickets" title={t('account.tickets.title', locale)}>
  <div class="pk-acct__head" style="display:flex;justify-content:space-between;align-items:center;gap:var(--sp-3);flex-wrap:wrap">
    <h1 class="pk-h1">{t('account.tickets.title', locale)}</h1>
    <button class="pk-btn pk-btn--sm" type="button" data-new-toggle><Icon name="plus" size={16} /> {t('account.tickets.new', locale)}</button>
  </div>

  <form class="pk-acct-card pk-form" data-new-form hidden novalidate>
    <div class="pk-form-alert pk-form-alert--error" data-new-err hidden></div>
    <div class="pk-field"><label class="pk-label" for="tk-subject">{t('account.tickets.subject', locale)} <span class="pk-req">*</span></label><input class="pk-input" id="tk-subject" name="title" required /></div>
    <div class="pk-field"><label class="pk-label" for="tk-msg">{t('account.tickets.message', locale)} <span class="pk-req">*</span></label><textarea class="pk-input" id="tk-msg" name="message" rows="4" required></textarea></div>
    <button class="pk-btn" type="submit" data-new-send>{t('account.tickets.send', locale)}</button>
  </form>

  <p class="pk-muted" data-loading>{t('account.loadingGeneric', locale)}</p>
  <p class="pk-muted" data-empty hidden>{t('account.tickets.empty', locale)}</p>
  <div class="pk-acct-card" data-list hidden><div class="pk-acct-rows" data-rows></div></div>

  <script define:vars={{ ticketBase, statusLabels: {
    new: t('account.tickets.status.new', locale), open: t('account.tickets.status.open', locale),
    client_replied: t('account.tickets.status.client_replied', locale), closed: t('account.tickets.status.closed', locale),
  }, msgsLabel: t('account.tickets.messagesCount', locale), saveError: t('account.saveError', locale) }}>
    window.__tkCfg = { ticketBase, statusLabels, msgsLabel, saveError };
  </script>
  <script>
    import { api } from '@lib/api';
    import { arabicDate } from '@lib/format';
    const cfg = (window as any).__tkCfg;
    const locale = location.pathname.startsWith('/en') ? 'en' : 'ar';
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    const toggle = document.querySelector<HTMLButtonElement>('[data-new-toggle]')!;
    const nform = document.querySelector<HTMLFormElement>('[data-new-form]')!;
    toggle.addEventListener('click', () => { nform.hidden = !nform.hidden; });
    nform.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = nform.querySelector<HTMLElement>('[data-new-err]')!;
      const btn = nform.querySelector<HTMLButtonElement>('[data-new-send]')!;
      err.hidden = true; btn.disabled = true;
      const title = (nform.elements.namedItem('title') as HTMLInputElement).value.trim();
      const message = (nform.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
      try {
        const r: any = await api.createTicket({ title, message });
        if (r && r.success && r.id) { location.href = `${cfg.ticketBase}?id=${encodeURIComponent(r.id)}`; return; }
        err.textContent = (r && r.message) || cfg.saveError; err.hidden = false;
      } catch { err.textContent = cfg.saveError; err.hidden = false; }
      btn.disabled = false;
    });

    const loadEl = document.querySelector<HTMLElement>('[data-loading]')!;
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
    const wrap = document.querySelector<HTMLElement>('[data-list]')!;
    const rows = document.querySelector<HTMLElement>('[data-rows]')!;
    api.tickets().then((res: any) => {
      loadEl.hidden = true;
      const items: any[] = (res && res.tickets) || [];
      if (!items.length) { emptyEl.hidden = false; return; }
      wrap.hidden = false;
      items.forEach((tk) => {
        const a = document.createElement('a');
        a.className = 'pk-acct-row';
        a.href = `${cfg.ticketBase}?id=${encodeURIComponent(tk.id)}`;
        const label = cfg.statusLabels[tk.status] || tk.status;
        const date = tk.last_activity || tk.created_at;
        a.innerHTML = `<span class="pk-acct-row__main">
            <span class="pk-acct-row__title">${esc(tk.title || '')}</span>
            <span class="pk-acct-row__meta">${esc(date ? arabicDate(date, locale) : '')} · ${esc(String(tk.messages || 0))} ${esc(cfg.msgsLabel)}</span>
          </span>
          <span class="pk-acct-row__end"><span class="pk-stat-pill pk-stat-pill--${esc(tk.status)}">${esc(label)}</span></span>`;
        rows.appendChild(a);
      });
    }).catch(() => { loadEl.hidden = true; emptyEl.hidden = false; });
  </script>
</AccountLayout>
