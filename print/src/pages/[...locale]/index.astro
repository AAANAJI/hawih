---
/**
 * Home page — Arabic at /, English at /en/.
 * Search-first hero (headline → search → category chips → product photo strip),
 * category grid, featured products, how-to steps, trust band.
 * LIVE-SYNC MARKERS (do not rename; see catalog-sync.ts):
 *   .pk-grid-cats · [data-featured-grid] (+ per-card data-product-* wrappers)
 */
import Base from '@layouts/Base.astro';
import CategoryTile from '@components/CategoryTile.astro';
import ProductCard from '@components/ProductCard.astro';
import SearchBox from '@components/SearchBox.astro';
import Icon from '@components/Icon.astro';
import JsonLd from '@components/JsonLd.astro';
import { localeStaticPaths } from '@lib/i18n';
import { href } from '@lib/i18n';
import { t } from '@lib/strings';
import { categories, items, categoryTitle, itemTitle, getCategory } from '@lib/catalog';
import { categoryImage } from '@lib/catalog-transform.mjs';
import { HAWIH_ORG_ID, SITE_URL, whatsappUrl } from '@lib/config';
import type { Locale } from '@lib/format';
import type { IconName } from '@lib/icons';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props as Props;

// Featured grid — slice size MUST match reconcileHome() in catalog-sync.ts.
const featured = items.slice(0, 8);

// Hero photo strip: first ~10 products with a real (CRM-hosted) photo.
const stripItems = items
  .filter((it) => /^https?:\/\//.test(it.images?.square ?? ''))
  .slice(0, 10);

const heroChips = categories.slice(0, 6);

// Promo tiles — target the sticker / card categories when present.
const stickersCat = categories.find((c) => c.slug.includes('sticker'));
const cardsCat = categories.find((c) => c.slug.includes('card'));
const promo1Href = href(locale, stickersCat ? `/category/${stickersCat.slug}` : '/products');
const promo2Href = href(locale, cardsCat ? `/category/${cardsCat.slug}` : '/products');
const promo1Img = stickersCat ? categoryImage(items, stickersCat.slug) : '';
const promo2Img = cardsCat ? categoryImage(items, cardsCat.slug) : '';

const steps = [
  { n: '1', title: t('step.1.title', locale), body: t('step.1.body', locale) },
  { n: '2', title: t('step.2.title', locale), body: t('step.2.body', locale) },
  { n: '3', title: t('step.3.title', locale), body: t('step.3.body', locale) },
];
const trust: { icon: IconName; label: string }[] = [
  { icon: 'receipt', label: t('trust.tax', locale) },
  { icon: 'landmark', label: t('trust.bank', locale) },
  { icon: 'message-circle', label: t('trust.whatsapp', locale) },
  { icon: 'zap', label: t('trust.turnaround', locale) },
];

// Structured data: Organization (store) linked to the main brand org.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#store`,
  name: t('brand.name', locale),
  url: SITE_URL,
  logo: `${SITE_URL}/img/logo/hawih-logo-dark.png`,
  parentOrganization: { '@id': HAWIH_ORG_ID },
  brand: { '@id': HAWIH_ORG_ID },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t('brand.name', locale),
  url: SITE_URL,
  inLanguage: locale === 'ar' ? 'ar-SA' : 'en',
};
---
<Base
  locale={locale}
  title={`${t('brand.name', locale)} — ${t('brand.tagline', locale)}`}
  description={t('hero.subtitle', locale)}
  path="/"
  image="/img/og/default.svg"
>
  <Fragment slot="head">
    <JsonLd data={[orgLd, websiteLd]} />
  </Fragment>

  <!-- Hero — search-first -->
  <section class="pk-hero">
    <div class="pk-container">
      <div class="pk-hero__center pk-reveal">
        <span class="pk-eyebrow pk-eyebrow--chip">{t('hero.eyebrow', locale)}</span>
        <h1 class="pk-display">{t('hero.title', locale)}</h1>
        <p class="pk-hero__sub pk-muted">{t('hero.subtitle', locale)}</p>

        <SearchBox locale={locale} />

        <div class="pk-chips" aria-label={t('nav.products', locale)}>
          <a class="pk-chip pk-chip--primary" href={href(locale, '/products')}>{t('nav.allProducts', locale)}</a>
          {heroChips.map((c) => (
            <a class="pk-chip" href={href(locale, `/category/${c.slug}`)}>{categoryTitle(c, locale)}</a>
          ))}
        </div>
      </div>
    </div>

    {stripItems.length > 3 && (
      <div class="pk-hero__strip">
        <div class="pk-marquee">
          {[false, true].map((dupe) => (
            <div class="pk-marquee__seg" aria-hidden={dupe ? 'true' : undefined}>
              {stripItems.map((it) => (
                <a class="pk-hero__stripcard" href={href(locale, `/product/${it.slug}`)} title={itemTitle(it, locale)} tabindex={dupe ? -1 : undefined}>
                  <img
                    src={it.images?.square}
                    alt={dupe ? '' : itemTitle(it, locale)}
                    loading="lazy"
                    decoding="async"
                    width="320"
                    height="320"
                    data-live-image
                    data-slug={it.slug}
                    onerror="this.parentElement.style.display='none'"
                  />
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- Categories -->
  <section class="pk-section" id="categories">
    <div class="pk-container">
      <div class="pk-section-head">
        <div>
          <h2 class="pk-h2">{t('home.categoriesTitle', locale)}</h2>
          <p>{t('home.categoriesSub', locale)}</p>
        </div>
      </div>
      <div class="pk-grid-cats">
        {categories.map((c, i) => (
          <div class="pk-reveal" style={`transition-delay:${Math.min(i, 8) * 60}ms`}>
            <CategoryTile
              title={categoryTitle(c, locale)}
              href={href(locale, `/category/${c.slug}`)}
              image={categoryImage(items, c.slug)}
              eager={i < 4}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Promo tiles -->
  <section class="pk-section" style="padding-top:0">
    <div class="pk-container pk-promos">
      <a class="pk-promo pk-promo--cobalt pk-reveal" href={promo1Href}>
        <div class="pk-promo__copy">
          <span class="pk-promo__kicker">{t('promo1.kicker', locale)}</span>
          <h3 class="pk-promo__title">{t('promo1.title', locale)}</h3>
          <p class="pk-promo__body">{t('promo1.body', locale)}</p>
          <span class="pk-btn pk-btn--light pk-btn--sm">{t('promo1.cta', locale)} <Icon name="arrow-end" size={14} class="pk-icon--flip" /></span>
        </div>
        {promo1Img && (
          <div class="pk-promo__media">
            <img src={promo1Img} alt="" loading="lazy" decoding="async" width="640" height="640" onerror="this.parentElement.style.display='none'" />
          </div>
        )}
      </a>
      <a class="pk-promo pk-promo--warm pk-reveal" style="transition-delay:90ms" href={promo2Href}>
        <div class="pk-promo__copy">
          <span class="pk-promo__kicker">{t('promo2.kicker', locale)}</span>
          <h3 class="pk-promo__title">{t('promo2.title', locale)}</h3>
          <p class="pk-promo__body">{t('promo2.body', locale)}</p>
          <span class="pk-btn pk-btn--sm">{t('promo2.cta', locale)} <Icon name="arrow-end" size={14} class="pk-icon--flip" /></span>
        </div>
        {promo2Img && (
          <div class="pk-promo__media">
            <img src={promo2Img} alt="" loading="lazy" decoding="async" width="640" height="640" onerror="this.parentElement.style.display='none'" />
          </div>
        )}
      </a>
    </div>
  </section>

  <!-- Featured products -->
  <section class="pk-section pk-section--band">
    <div class="pk-container">
      <div class="pk-section-head">
        <div>
          <span class="pk-eyebrow pk-eyebrow--chip">{t('home.featuredTitle', locale)}</span>
          <h2 class="pk-h2" style="margin-top:var(--sp-2)">{t('home.featuredSub', locale)}</h2>
        </div>
        <a class="pk-btn pk-btn--ghost pk-btn--sm" href={href(locale, '/products')}>
          {t('home.viewAll', locale)}
          <Icon name="arrow-end" size={15} class="pk-icon--flip" />
        </a>
      </div>
      <div class="pk-grid-products" data-featured-grid>
        {featured.map((it, i) => {
          const cat = getCategory(it.category_slug);
          return (
            <div class="pk-reveal" style={`transition-delay:${Math.min(i, 8) * 60}ms`} data-product-id={it.id} data-product-name={itemTitle(it, locale)} data-product-price={it.rate} data-product-cat={it.category_slug}>
              <ProductCard
                href={href(locale, `/product/${it.slug}`)}
                title={itemTitle(it, locale)}
                image={it.images?.square ?? ''}
                rate={it.rate}
                categoryLabel={cat ? categoryTitle(cat, locale) : undefined}
                locale={locale}
              />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- How to order -->
  <section class="pk-section" id="how">
    <div class="pk-container">
      <div class="pk-section-head">
        <div>
          <h2 class="pk-h2">{t('home.stepsTitle', locale)}</h2>
          <p>{t('home.stepsSub', locale)}</p>
        </div>
      </div>
      <div class="pk-steps">
        {steps.map((s, i) => (
          <div class="pk-card pk-step pk-reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="pk-step__num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Design-help banner -->
  <section class="pk-container" style="margin-bottom:var(--sp-6)">
    <div class="pk-banner pk-reveal">
      <div class="pk-banner__deco" aria-hidden="true"></div>
      <div class="pk-banner__copy">
        <h2 class="pk-h2">{t('banner.title', locale)}</h2>
        <p>{t('banner.body', locale)}</p>
      </div>
      <a class="pk-btn pk-btn--light pk-btn--lg" href={whatsappUrl()} target="_blank" rel="noopener">
        <Icon name="message-circle" size={18} />
        {t('banner.cta', locale)}
      </a>
    </div>
  </section>

  <!-- Trust band -->
  <section class="pk-trustband">
    <div class="pk-container pk-trust">
      {trust.map((x) => (
        <div class="pk-trust__item">
          <span class="pk-trust__icon" aria-hidden="true"><Icon name={x.icon} size={19} /></span>
          <span>{x.label}</span>
        </div>
      ))}
    </div>
  </section>

  <script>
    import { viewItemList } from '@lib/gtm';
    const grid = document.querySelector('[data-featured-grid]');
    if (grid) {
      const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-product-id]')).map((el) => ({
        item_id: el.dataset.productId!,
        item_name: el.dataset.productName!,
        price: Number(el.dataset.productPrice),
        item_category: el.dataset.productCat!,
      }));
      viewItemList('featured', items);
    }
  </script>
</Base>
