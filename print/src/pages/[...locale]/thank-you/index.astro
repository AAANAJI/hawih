---
/**
 * Thank-you — /thank-you and /en/thank-you.
 * Reads the last order from sessionStorage, shows the order number, next
 * steps, bank-transfer details + WhatsApp CTA. Fires GTM purchase, clears cart.
 */
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import Button from '@components/Button.astro';
import { localeStaticPaths, href } from '@lib/i18n';
import { t } from '@lib/strings';
import { BANK_TRANSFER, WHATSAPP } from '@lib/config';
import type { Locale } from '@lib/format';

export const getStaticPaths = localeStaticPaths;
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const title = t('page.thankyou', locale);
const accountHref = href(locale, '/account');
const shopHref = href(locale, '/');
const bankName = locale === 'ar' ? BANK_TRANSFER.bank_name_ar : BANK_TRANSFER.bank_name_en;

const steps = [
  { icon: 'palette' as const, title: t('thanks.next1.title', locale), body: t('thanks.next1.body', locale) },
  { icon: 'message-circle' as const, title: t('thanks.next2.title', locale), body: t('thanks.next2.body', locale) },
  { icon: 'receipt' as const, title: t('thanks.next3.title', locale), body: t('thanks.next3.body', locale) },
];
---
<Base
  locale={locale}
  title={`${title} — ${t('brand.name', locale)}`}
  description={t('thanks.sub', locale)}
  path="/thank-you"
  noindex={true}
>
  <div class="pk-container">
    <div class="pk-thanks">
      <div class="pk-thanks__icon" aria-hidden="true"><Icon name="check" size={32} /></div>
      <h1 class="pk-h1">{t('thanks.title', locale)}</h1>
      <p class="pk-thanks__sub">{t('thanks.sub', locale)}</p>
      <div class="pk-thanks__numwrap" data-order-numwrap hidden>
        <span class="pk-thanks__numlabel">{t('thanks.orderNum', locale)}</span>
        <span class="pk-thanks__num" data-order-num></span>
      </div>
      <p class="pk-muted" data-no-order hidden style="margin-top:var(--sp-4)">{t('thanks.noOrder', locale)}</p>
      <div class="pk-thanks__actions">
        <Button href={accountHref}>{t('thanks.viewAccount', locale)}</Button>
        <Button href={shopHref} variant="outline">{t('thanks.continue', locale)}</Button>
      </div>
    </div>

    <section class="pk-section" data-thanks-upload hidden style="padding-top:0;max-width:720px;margin-inline:auto">
      <div class="pk-card pk-block" style="margin-bottom:0">
        <h2 class="pk-h3">{t('thanks.uploadTitle', locale)}</h2>
        <p class="pk-small pk-muted" style="margin-top:calc(-1 * var(--sp-2))">{t('thanks.uploadHint', locale)}</p>
        <div data-thanks-item-uploads></div>
      </div>
    </section>

    <section class="pk-section" style="padding-top:0">
      <div class="pk-section-head" style="justify-content:center;text-align:center">
        <h2 class="pk-h2">{t('thanks.next', locale)}</h2>
      </div>
      <div class="pk-steps">
        {steps.map((s, i) => (
          <div class="pk-card pk-step">
            <div class="pk-step__num" aria-hidden="true"><Icon name={s.icon} size={18} /></div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="pk-section" style="padding-top:0;max-width:640px;margin-inline:auto">
      <div class="pk-bank">
        <h3>{t('bank.title', locale)}</h3>
        <dl class="pk-bank__rows">
          <div class="pk-bank__row"><dt>{t('bank.bank', locale)}</dt><dd>{bankName}</dd></div>
          <div class="pk-bank__row"><dt>{t('bank.accountName', locale)}</dt><dd>{BANK_TRANSFER.account_name}</dd></div>
          <div class="pk-bank__row">
            <dt>{t('bank.iban', locale)}</dt>
            <dd class="pk-bank__val"><span>{BANK_TRANSFER.iban}</span><button type="button" class="pk-bank__copy" data-copy-iban data-copy-label={t('bank.copy', locale)} data-copied-label={t('bank.copied', locale)}>{t('bank.copy', locale)}</button></dd>
          </div>
        </dl>
        <p class="pk-bank__note">{t('bank.note', locale)}</p>
      </div>
      <div style="text-align:center;margin-top:var(--sp-5)">
        <a class="pk-btn pk-btn--outline" data-whatsapp target="_blank" rel="noopener">
          <Icon name="message-circle" size={16} /> {t('whatsapp.cta', locale)}
        </a>
      </div>
    </section>
  </div>

  <script define:vars={{
    locale,
    whatsapp: WHATSAPP,
    waPrefix: locale === 'ar' ? 'مرحباً هوية، أرغب بمتابعة طلبي رقم ' : 'Hello Hawih, I would like to follow up on my order ',
    ibanRaw: BANK_TRANSFER.iban,
    uploadLabels: {
      uploadBtn: t('order.uploadBtn', locale),
      uploading: t('order.uploading', locale),
      uploadError: t('order.uploadError', locale),
      hint: t('order.uploadItemHint', locale),
    },
  }}>
    window.__thanksCfg = { locale, whatsapp, waPrefix, ibanRaw, uploadLabels };
  </script>
  <script>
    import { getLastOrder } from '@lib/checkout';
    import { clearCart } from '@lib/cart';
    import { purchase } from '@lib/gtm';
    import { isAuthed, api } from '@lib/api';
    import { buildItemUploader } from '@lib/itemUpload';

    const cfg = (window as any).__thanksCfg;
    const order = getLastOrder();

    const numWrap = document.querySelector<HTMLElement>('[data-order-numwrap]');
    const numEl = document.querySelector<HTMLElement>('[data-order-num]');
    const noOrder = document.querySelector<HTMLElement>('[data-no-order]');
    const waLink = document.querySelector<HTMLAnchorElement>('[data-whatsapp]');

    const display = order ? (order.order_display || (order.order_id != null ? String(order.order_id) : '')) : '';

    if (order && display) {
      if (numWrap) numWrap.hidden = false;
      if (numEl) numEl.textContent = display;
      // GTM purchase (revenue tracking; cart already cleared at checkout time)
      purchase(String(order.order_id ?? display), Number(order.total ?? 0), []);
      // Invite the buyer to attach a design file to each item they just ordered.
      if (order.order_id != null && isAuthed()) mountItemUploads(order.order_id);
    } else {
      if (noOrder) noOrder.hidden = false;
    }

    // Fetch the placed order and render a per-item uploader for each line.
    async function mountItemUploads(orderId: string | number) {
      let res: any;
      try {
        res = await api.order(orderId);
      } catch { return; }
      const items: any[] = (res && res.success && res.order && res.order.items) || [];
      if (!items.length) return;
      const wrap = document.querySelector<HTMLElement>('[data-thanks-upload]');
      const host = document.querySelector<HTMLElement>('[data-thanks-item-uploads]');
      if (!wrap || !host) return;
      items.forEach((it) => {
        const block = document.createElement('div');
        block.className = 'pk-itemup-block';
        const title = document.createElement('div');
        title.className = 'pk-itemup-block__title';
        title.textContent = it.title;
        block.appendChild(title);
        block.appendChild(buildItemUploader({
          orderId,
          itemId: it.item_id,
          files: it.files || [],
          labels: cfg.uploadLabels,
        }));
        host.appendChild(block);
      });
      wrap.hidden = false;
    }

    // WhatsApp CTA prefilled with order number
    const msg = cfg.waPrefix + (display || '');
    if (waLink) waLink.href = `https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(msg)}`;

    // Copy IBAN
    const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-iban]');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cfg.ibanRaw.replace(/\s/g, ''));
        const done = copyBtn.dataset.copiedLabel || 'Copied';
        const orig = copyBtn.dataset.copyLabel || 'Copy';
        copyBtn.textContent = done;
        setTimeout(() => { copyBtn.textContent = orig; }, 1800);
      } catch { /* clipboard unavailable */ }
    });

    // Ensure cart is empty + header badge updates.
    clearCart();
  </script>
</Base>
