---
/**
 * Category page — /category/{slug} and /en/category/{slug}.
 * Breadcrumbs, header, product grid, EmptyState, JSON-LD (CollectionPage +
 * ItemList + BreadcrumbList), GTM view_item_list.
 */
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ProductCard from '@components/ProductCard.astro';
import CategoryTile from '@components/CategoryTile.astro';
import TrustBar from '@components/TrustBar.astro';
import EmptyState from '@components/EmptyState.astro';
import Button from '@components/Button.astro';
import JsonLd from '@components/JsonLd.astro';
import { href } from '@lib/i18n';
import { t } from '@lib/strings';
import { formatNumber } from '@lib/format';
import { categories, items, itemsInCategory, getCategory, categoryTitle, itemTitle } from '@lib/catalog';
import { categoryImage } from '@lib/catalog-transform.mjs';
import { SITE_URL } from '@lib/config';
import type { Locale } from '@lib/format';

export function getStaticPaths() {
  const out: { params: { locale: string | undefined; slug: string }; props: { locale: Locale } }[] = [];
  for (const l of [undefined, 'en'] as const) {
    for (const c of categories) {
      out.push({ params: { locale: l, slug: c.slug }, props: { locale: l === 'en' ? 'en' : 'ar' } });
    }
  }
  return out;
}
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const { slug } = Astro.params;
const category = getCategory(slug!)!;
const products = itemsInCategory(slug!);
const title = categoryTitle(category, locale);
const ogImage = categoryImage(items, slug!);
// HelloPrint-style split hero: a big photo tile + a grid of up to 6 SIBLING
// category tiles (other categories, this one excluded).
const heroPhoto = products.find((p) => /^https?:\/\//.test(p.images?.hero ?? ''))?.images?.hero || ogImage;
const siblings = categories.filter((c) => c.slug !== slug).slice(0, 6);
const blurb = t('category.blurb', locale).replace('{cat}', title);

const crumbs = [
  { label: t('nav.home', locale), href: href(locale, '/') },
  { label: t('nav.products', locale), href: href(locale, '/#categories') },
  { label: title },
];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: SITE_URL + href(locale, `/category/${slug}`),
  inLanguage: locale === 'ar' ? 'ar-SA' : 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: products.length,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: SITE_URL + href(locale, `/product/${p.slug}`),
      name: itemTitle(p, locale),
    })),
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: SITE_URL + c.href } : {}),
  })),
};
---
<Base
  locale={locale}
  title={`${title} — ${t('brand.name', locale)}`}
  description={`${title} · ${t('brand.tagline', locale)}`}
  path={`/category/${slug}`}
  image={ogImage}
>
  <Fragment slot="head">
    <JsonLd data={[collectionLd, breadcrumbLd]} />
  </Fragment>

  <div class="pk-container">
    <Breadcrumbs items={crumbs} />
    <div class="pk-pagehead">
      <h1 class="pk-h1" data-live-cat-title>{title}</h1>
      <p class="pk-muted" style="max-width:70ch">{blurb}</p>
      <p data-live-cat-count>{formatNumber(products.length, locale)} {t('category.productsCount', locale)}</p>
    </div>

    <TrustBar locale={locale} />

    <!-- Lateral category navigation (baked; new categories appear after the
         daily rebuild — same policy as new URLs/sitemap). -->
    <div class="pk-chips pk-chips--scroll" aria-label={t('nav.products', locale)}>
      <a class="pk-chip" href={href(locale, '/products')}>{t('nav.allProducts', locale)}</a>
      {categories.map((c) => (
        <a class={`pk-chip${c.slug === slug ? ' pk-chip--primary' : ''}`} href={href(locale, `/category/${c.slug}`)} aria-current={c.slug === slug ? 'page' : undefined}>
          {categoryTitle(c, locale)}
        </a>
      ))}
    </div>

    <!-- Split hero: photo feature + sibling category tiles -->
    <div class="pk-cathero pk-reveal">
      <div class="pk-cathero__feature">
        {heroPhoto && <img src={heroPhoto} alt="" loading="eager" decoding="async" width="1000" height="800" onerror="this.remove()" />}
        <div>
          <h2 class="pk-cathero__title">{t('category.heroTitle', locale).replace('{cat}', title)}</h2>
          <p class="pk-cathero__body">{t('category.heroBody', locale)}</p>
        </div>
      </div>
      <div class="pk-cathero__grid" aria-label={t('category.browse', locale)}>
        {siblings.map((c) => (
          <CategoryTile
            title={categoryTitle(c, locale)}
            href={href(locale, `/category/${c.slug}`)}
            image={categoryImage(items, c.slug)}
          />
        ))}
      </div>
    </div>

    <div class="pk-section-head"><div><h2 class="pk-h2">{t('category.popular', locale)}</h2></div></div>

    <!-- data-cat-body is the region catalog-sync re-renders live from the CRM -->
    <div data-cat-body>
      {products.length > 0 ? (
        <div class="pk-grid-products" data-cat-grid style="margin-bottom:var(--sp-10)">
          {products.map((p, i) => (
            <div data-product-id={p.id} data-product-name={itemTitle(p, locale)} data-product-price={p.rate}>
              <ProductCard
                href={href(locale, `/product/${p.slug}`)}
                title={itemTitle(p, locale)}
                image={p.images?.square ?? ''}
                rate={p.rate}
                categoryLabel={title}
                locale={locale}
                itemMode={p.price_mode}
                badge={i < 2 ? t('badge.popular', locale) : p.requires_artwork ? t('badge.upload', locale) : ''}
                fastChip={true}
              />
            </div>
          ))}
        </div>
      ) : (
        <div style="margin-bottom:var(--sp-10)">
          <EmptyState icon="folder" title={t('category.empty.title', locale)} body={t('category.empty.body', locale)}>
            <Button href={href(locale, '/')}>{t('common.backHome', locale)}</Button>
          </EmptyState>
        </div>
      )}
    </div>
  </div>

  <script>
    import { viewItemList } from '@lib/gtm';
    const grid = document.querySelector('[data-cat-grid]');
    if (grid) {
      const list = Array.from(grid.querySelectorAll('[data-product-id]')).map((el) => ({
        item_id: el.dataset.productId,
        item_name: el.dataset.productName,
        price: Number(el.dataset.productPrice),
      }));
      viewItemList(location.pathname, list);
    }
  </script>
</Base>
