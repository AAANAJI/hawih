---
/**
 * Product page — /product/{slug} and /en/product/{slug}.
 * Gallery, title, description, OptionPicker (drives PriceBox), QtyStepper,
 * add-to-cart, specs, related products. JSON-LD Product+Offer+Breadcrumb.
 */
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import OptionPicker from '@components/OptionPicker.astro';
import PriceBox from '@components/PriceBox.astro';
import QtyStepper from '@components/QtyStepper.astro';
import ProductCard from '@components/ProductCard.astro';
import Button from '@components/Button.astro';
import JsonLd from '@components/JsonLd.astro';
import { href } from '@lib/i18n';
import { t } from '@lib/strings';
import {
  items,
  getItem,
  getCategory,
  relatedItems,
  categoryTitle,
  itemTitle,
  itemDescription,
} from '@lib/catalog';
import { SITE_URL, HAWIH_ORG_ID, UPLOAD } from '@lib/config';
import type { Locale } from '@lib/format';

export function getStaticPaths() {
  const out: { params: { locale: string | undefined; slug: string }; props: { locale: Locale } }[] = [];
  for (const l of [undefined, 'en'] as const) {
    for (const it of items) {
      out.push({ params: { locale: l, slug: it.slug }, props: { locale: l === 'en' ? 'en' : 'ar' } });
    }
  }
  return out;
}
interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const { slug } = Astro.params;
const item = getItem(slug!)!;
const category = getCategory(item.category_slug)!;
const title = itemTitle(item, locale);
const desc = itemDescription(item, locale);
const catTitle = categoryTitle(category, locale);
const related = relatedItems(item);
const unit = locale === 'ar' ? item.unit_type : item.unit_type_en ?? item.unit_type;

const crumbs = [
  { label: t('nav.home', locale), href: href(locale, '/') },
  { label: catTitle, href: href(locale, `/category/${category.slug}`) },
  { label: title },
];

const absImg = (p: string | undefined) => (!p ? '' : p.startsWith('http') ? p : SITE_URL + p);
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: desc,
  image: absImg(item.images?.hero),
  category: catTitle,
  brand: { '@id': HAWIH_ORG_ID },
  offers: {
    '@type': 'Offer',
    price: item.rate,
    priceCurrency: 'SAR',
    availability: 'https://schema.org/InStock',
    url: SITE_URL + href(locale, `/product/${slug}`),
    seller: { '@id': HAWIH_ORG_ID },
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: SITE_URL + c.href } : {}),
  })),
};
---
<Base
  locale={locale}
  title={`${title} — ${t('brand.name', locale)}`}
  description={desc}
  path={`/product/${slug}`}
  image={item.images?.hero}
  type="product"
>
  <Fragment slot="head">
    <JsonLd data={[productLd, breadcrumbLd]} />
  </Fragment>

  <div class="pk-container">
    <Breadcrumbs items={crumbs} />

    <div class="pk-pdp" style="margin-block:var(--sp-4) var(--sp-10)">
      <!-- Gallery -->
      <div class="pk-pdp__gallery">
        <div class="pk-pdp__hero">
          <img id="pdp-hero" src={item.images?.hero} alt={title} width="1600" height="1200" fetchpriority="high" />
        </div>
        <div class="pk-pdp__thumbs">
          <button class="pk-pdp__thumb" type="button" data-thumb={item.images?.hero} aria-label={title}>
            <img src={item.images?.hero} alt="" width="200" height="200" loading="lazy" />
          </button>
          <button class="pk-pdp__thumb" type="button" data-thumb={item.images?.square} aria-label={title}>
            <img src={item.images?.square} alt="" width="200" height="200" loading="lazy" />
          </button>
        </div>
      </div>

      <!-- Buy box -->
      <div class="pk-pdp__buy"
        data-product
        data-item-id={item.id}
        data-slug={item.slug}
        data-title={title}
        data-base={item.rate}
        data-image={item.images?.square}
        data-min-qty={item.min_qty ?? 1}
        data-locale={locale}
        data-requires-artwork={item.requires_artwork ? '1' : ''}
      >
        <span class="pk-prodcard__tag" style="align-self:flex-start">{catTitle}</span>
        <h1 class="pk-h1" style="margin-top:var(--sp-1)">{title}</h1>
        <PriceBox amount={item.rate} locale={locale} id="pdp-price" />
        <p class="pk-muted">{desc}</p>

        <OptionPicker options={item.options} locale={locale} />

        <div class="pk-pdp__qtyrow">
          <div>
            <span class="pk-optgroup__label" style="display:block;margin-bottom:var(--sp-2)">{t('product.quantity', locale)}</span>
            <QtyStepper id="pdp-qty" min={item.min_qty ?? 1} label={t('product.quantity', locale)} />
          </div>
          <Button size="lg" data-add-to-cart style="flex:1;min-width:180px">{t('product.addToCart', locale)}</Button>
        </div>

        {item.requires_artwork && (
          <div style="margin-top:var(--sp-2)">
            <p class="pk-small pk-muted" style="display:flex;gap:8px;align-items:center;margin-bottom:var(--sp-2)">
              <span aria-hidden="true">🎨</span> {t('product.artworkNote', locale)}
            </p>
            <div class="pk-upload" data-pdp-upload>
              <label class="pk-upload__zone" tabindex="0" role="button" data-pdp-zone>
                <span aria-hidden="true" style="font-size:1.4rem;color:var(--pk-accent)">⬆</span>
                <strong>{t('upload.drop', locale)}</strong>
                <span class="pk-upload__hint">{t('upload.hint', locale)}</span>
                <input type="file" accept={UPLOAD.accept.map((e) => '.' + e).join(',')} multiple class="pk-visually-hidden" data-pdp-input />
              </label>
              <p class="pk-upload__error" data-pdp-error hidden></p>
              <ul class="pk-upload__list" data-pdp-list></ul>
            </div>
          </div>
        )}

        <!-- Specs -->
        <div class="pk-card" style="padding:var(--sp-5);margin-top:var(--sp-2)">
          <h2 class="pk-h3" style="margin-bottom:var(--sp-4)">{t('product.specs', locale)}</h2>
          <dl class="pk-specs">
            <div><dt>{t('product.spec.category', locale)}</dt><dd>{catTitle}</dd></div>
            <div><dt>{t('product.spec.unit', locale)}</dt><dd>{unit}</dd></div>
            <div><dt>{t('product.spec.turnaround', locale)}</dt><dd>{t('product.turnaroundValue', locale)}</dd></div>
            <div><dt>{t('product.spec.artwork', locale)}</dt><dd>{item.requires_artwork ? t('product.yes', locale) : '—'}</dd></div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <section class="pk-section" style="padding-top:0">
        <div class="pk-section-head">
          <h2 class="pk-h2">{t('product.related', locale)}</h2>
        </div>
        <div class="pk-grid-products">
          {related.map((r) => (
            <ProductCard
              href={href(locale, `/product/${r.slug}`)}
              title={itemTitle(r, locale)}
              image={r.images?.square ?? ''}
              rate={r.rate}
              categoryLabel={catTitle}
              locale={locale}
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    import { addToCart, type ArtworkRef } from '@lib/cart';
    import { addToCartEvent, viewItem } from '@lib/gtm';
    import { formatSAR, formatNumber } from '@lib/format';
    import { liveItem } from '@lib/live-prices';
    import { api } from '@lib/api';
    import { UPLOAD } from '@lib/config';

    const root = document.querySelector<HTMLElement>('[data-product]');
    if (root) {
      const locale = (root.dataset.locale === 'en' ? 'en' : 'ar') as 'ar' | 'en';
      let base = Number(root.dataset.base);
      const itemId = root.dataset.itemId!;
      const slug = root.dataset.slug!;
      const title = root.dataset.title!;
      const image = root.dataset.image!;
      const priceEl = root.querySelector<HTMLElement>('[data-pricebox-amount]');
      const qtyInput = document.querySelector<HTMLInputElement>('#pdp-qty');
      const addBtn = root.querySelector<HTMLElement>('[data-add-to-cart]');

      function currentSelections() {
        const groups = root!.querySelectorAll<HTMLElement>('fieldset[data-option-name]');
        let delta = 0;
        const options: Record<string, string> = {};
        groups.forEach((g) => {
          const checked = g.querySelector<HTMLInputElement>('input:checked');
          if (checked) {
            options[g.dataset.optionName!] = checked.value;
            delta += Number(checked.dataset.delta || '0');
          }
        });
        return { options, rate: base + delta };
      }

      function refreshPrice() {
        const { rate } = currentSelections();
        if (priceEl) priceEl.textContent = formatSAR(rate, locale);
      }

      root.querySelectorAll('input[type=radio]').forEach((r) =>
        r.addEventListener('change', refreshPrice),
      );
      refreshPrice();

      // Live sync: overwrite the baked base rate + option deltas from the CRM,
      // then recompute. Falls back silently to baked values if the API is down.
      liveItem(slug).then((live) => {
        if (!live) return;
        if (Number.isFinite(Number(live.rate))) {
          base = Number(live.rate);
          root!.dataset.base = String(base);
          if (priceEl) priceEl.dataset.base = String(base);
        }
        // Live sync the CRM-managed product image onto the hero + thumbnails.
        if (live.image) {
          const hero = document.querySelector<HTMLImageElement>('#pdp-hero');
          if (hero) hero.src = live.image;
          document.querySelectorAll<HTMLElement>('[data-thumb]').forEach((btn, i) => {
            if (i === 0) {
              btn.dataset.thumb = live.image;
              const timg = btn.querySelector('img');
              if (timg) (timg as HTMLImageElement).src = live.image!;
            }
          });
          root!.dataset.image = live.image;
        }
        if (Array.isArray(live.options)) {
          root!.querySelectorAll<HTMLElement>('fieldset[data-option-name-ar]').forEach((g) => {
            const nameAr = g.getAttribute('data-option-name-ar');
            const lo = live.options!.find((o) => o.name_ar === nameAr);
            if (!lo || !Array.isArray(lo.values)) return;
            g.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((inp) => {
              const lv = lo.values.find((v) => {
                if (typeof v === 'string') return v === inp.value;
                const la = v.label_ar != null ? v.label_ar : v.label;
                return la === inp.value;
              });
              if (lv && typeof lv === 'object' && typeof lv.price_delta === 'number') {
                inp.dataset.delta = String(lv.price_delta);
                const deltaSpan = inp.parentElement?.querySelector('.pk-pill__delta');
                if (deltaSpan) {
                  deltaSpan.textContent = lv.price_delta > 0 ? '+' + formatNumber(lv.price_delta, locale) : '';
                }
              }
            });
          });
        }
        refreshPrice();
      });

      // view_item
      viewItem({ item_id: itemId, item_name: title, price: base, item_category: root.dataset.slug });

      // ---- Artwork upload (immediate → CRM temp; refs travel in the cart) ----
      const requiresArtwork = root.dataset.requiresArtwork === '1';
      const artworkRefs: ArtworkRef[] = [];
      const up = root.querySelector<HTMLElement>('[data-pdp-upload]');
      const upInput = root.querySelector<HTMLInputElement>('[data-pdp-input]');
      const upZone = root.querySelector<HTMLElement>('[data-pdp-zone]');
      const upList = root.querySelector<HTMLUListElement>('[data-pdp-list]');
      const upErr = root.querySelector<HTMLElement>('[data-pdp-error]');

      const human = (b: number) =>
        b < 1024 ? b + ' B' : b < 1048576 ? Math.round(b / 1024) + ' KB' : (b / 1048576).toFixed(1) + ' MB';
      function upShowErr(m: string) {
        if (!upErr) return;
        upErr.textContent = m;
        upErr.hidden = false;
        setTimeout(() => { upErr.hidden = true; }, 4000);
      }
      function upRender() {
        if (!upList) return;
        upList.innerHTML = '';
        artworkRefs.forEach((a, i) => {
          const li = document.createElement('li');
          li.className = 'pk-filechip';
          const meta = document.createElement('div');
          meta.className = 'pk-filechip__meta';
          const nm = document.createElement('span');
          nm.className = 'pk-filechip__name';
          nm.textContent = a.orig_name;
          const sz = document.createElement('span');
          sz.className = 'pk-filechip__size';
          sz.textContent = human(a.file_size);
          meta.append(nm, sz);
          const rm = document.createElement('button');
          rm.type = 'button';
          rm.className = 'pk-filechip__remove';
          rm.textContent = '✕';
          rm.setAttribute('aria-label', 'x');
          rm.addEventListener('click', () => { artworkRefs.splice(i, 1); upRender(); });
          li.append(meta, rm);
          upList.appendChild(li);
        });
      }
      async function upAccept(fl: FileList | File[]) {
        for (const f of Array.from(fl)) {
          const ext = (f.name.split('.').pop() || '').toLowerCase();
          if (!UPLOAD.accept.includes(ext)) { upShowErr((locale === 'ar' ? 'صيغة غير مدعومة: ' : 'Unsupported type: ') + f.name); continue; }
          if (f.size > UPLOAD.maxBytes) { upShowErr((locale === 'ar' ? 'حجم كبير جداً: ' : 'Too large: ') + f.name); continue; }
          try {
            const res = (await api.uploadArtwork(f)) as any;
            if (res && res.success && res.file_name) {
              artworkRefs.push({ file_name: res.file_name, file_size: Number(res.file_size) || f.size, orig_name: res.orig_name || f.name });
              upRender();
            } else {
              upShowErr(res?.message || (locale === 'ar' ? 'فشل الرفع' : 'Upload failed'));
            }
          } catch {
            upShowErr(locale === 'ar' ? 'فشل الرفع' : 'Upload failed');
          }
        }
      }
      if (upInput && upZone) {
        upInput.addEventListener('change', () => { if (upInput.files) upAccept(upInput.files); upInput.value = ''; });
        upZone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); upInput.click(); } });
        ['dragover', 'dragenter'].forEach((ev) => upZone.addEventListener(ev, (e) => { e.preventDefault(); upZone.classList.add('is-drag'); }));
        ['dragleave', 'dragend', 'drop'].forEach((ev) => upZone.addEventListener(ev, () => upZone.classList.remove('is-drag')));
        upZone.addEventListener('drop', (e) => { e.preventDefault(); const dt = (e as DragEvent).dataTransfer; if (dt?.files) upAccept(dt.files); });
      }

      addBtn?.addEventListener('click', () => {
        if (requiresArtwork && artworkRefs.length === 0) {
          upShowErr(locale === 'ar' ? 'الرجاء رفع ملف التصميم أولاً' : 'Please upload your design first');
          up?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        const { options, rate } = currentSelections();
        const qty = Math.max(Number(root!.dataset.minQty || '1'), Number(qtyInput?.value || '1'));
        addToCart({ item_id: itemId, slug, title, qty, rate, options, image, artwork: artworkRefs.slice() });
        addToCartEvent({ item_id: itemId, item_name: title, price: rate, quantity: qty, item_category: slug });
        artworkRefs.length = 0;
        upRender();
        const original = addBtn.textContent;
        addBtn.textContent = locale === 'ar' ? 'تمت الإضافة ✓' : 'Added ✓';
        setTimeout(() => { addBtn.textContent = original; }, 1600);
      });

      // Thumbnail swap
      const hero = document.querySelector<HTMLImageElement>('#pdp-hero');
      document.querySelectorAll<HTMLElement>('[data-thumb]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (hero && btn.dataset.thumb) hero.src = btn.dataset.thumb;
        });
      });
    }
  </script>
</Base>
