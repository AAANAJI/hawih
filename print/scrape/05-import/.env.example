# Copy to `.env` (same folder) and fill in. `.env` is gitignored — never commit it.

# CRM base (no trailing slash). The script adds /index.php/print_api itself.
CRM_BASE_URL=https://crm.hawih.com.sa

# Your CRM admin login — the same email + password you sign in to
# crm.hawih.com.sa with. Sent over HTTPS (Basic auth). No server setup needed.
CRM_ADMIN_EMAIL=you@hawih.com.sa
CRM_ADMIN_PASSWORD=your-crm-password

# Absolute paths to the catalog files on your machine.
SKELETON_PATH=/Users/Anaji/My Drive/print hawih/weej/03-hawih/catalog-skeleton.json
XLSX_PATH=/Users/Anaji/My Drive/print hawih/weej/03-hawih/catalog-review.xlsx

# Folder containing product images. The script looks for, per service:
#   <IMAGES_DIR>/<key>/hero.<ext>  ·  <IMAGES_DIR>/<key>/og.<ext>
#   <IMAGES_DIR>/<key>.<ext>       ·  first image inside <IMAGES_DIR>/<key>/
# where <key> = service id / slug / legacy product id. Exts: png webp jpg jpeg gif.
IMAGES_DIR=/Users/Anaji/My Drive/print hawih/weej/04-images/generated

# Optional: a shared import token instead of admin login (leave blank to use the
# admin login above).
# PRINT_IMPORT_TOKEN=
